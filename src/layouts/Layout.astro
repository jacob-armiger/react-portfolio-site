---
import Analytics from "@vercel/analytics/astro";
import { Font } from "astro:assets";
import "../styles/global.css";
// Fonts: Inter (sans/UI), Source Serif 4 (body), Playfair Display (headings).
// Registered in astro.config.mjs and rendered by the <Font> tags below.
import Footer from "../components/Footer.astro";
import InstagramGlyph from "../components/InstagramGlyph.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import ColorLab from "../dev/color-lab/ColorLab.astro";
import { backgroundTexture, type TextureSettings } from "../config/backgroundTexture";
import { PAPER } from "../config/colors";
import defaultShareImage from "../assets/share/default.jpeg";
import { DEFAULT_DESCRIPTION, SITE_NAME, shareImage, type SharePosition } from "../utils/share";
import { CARD_HEIGHT, CARD_WIDTH } from "../utils/shareCard";
import type { ImageMetadata } from "astro";

interface Props {
    title: string;
    description?: string;
    /** An image to crop to the share size, or the path of a ready-made 1200x630 card. */
    image?: ImageMetadata | string;
    imageAlt?: string;
    imagePosition?: SharePosition;
    type?: "website" | "article";
    publishedTime?: Date;
    noindex?: boolean;
    /** The page opens with a hero that runs up behind the topbar (below lg). */
    heroNav?: boolean;
}

const {
    title,
    description = DEFAULT_DESCRIPTION,
    image,
    imageAlt = image ? "" : "Charcoal drawing of a classical figure by Jacob",
    imagePosition = image ? "attention" : "top",
    type = "website",
    publishedTime,
    noindex = false,
    heroNav = false,
} = Astro.props;

// Normalize trailing slashes so /writing/ and /writing compare equal.
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalUrl = new URL(currentPath, Astro.site).toString();
const documentTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;
const share =
    typeof image === "string"
        ? { src: image, width: CARD_WIDTH, height: CARD_HEIGHT }
        : await shareImage(image ?? defaultShareImage, imagePosition);
const shareImageUrl = new URL(share.src, Astro.site).toString();
const feeds = [
    { href: "/feed/rss.xml", title: "Blog and Art – JacobLDraws" },
    { href: "/writing/rss.xml", title: "Articles – JacobLDraws" },
    { href: "/art/rss.xml", title: "Art – JacobLDraws" },
    { href: "/rss.xml", title: "Books – JacobLDraws" },
];
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href + "/");
const navLinks = [
    { href: "/art-lessons", label: "Lessons" },
    { href: "/art", label: "Art" },
    { href: "/writing", label: "Blog" },
    { href: "/books", label: "Books", visibility: "hidden md:block" },
    { href: "/directory", label: "Directory", visibility: "hidden sm:block" },
];
// Active nav state is the full-ink color alone; resting links sit at /70.
const NAV_LINK_CLASS = "hover:underline lg:font-medium";
const NAV_INK_REST = "text-ink-muted";
const NAV_INK_CURRENT = "text-ink";
// Texture dials live in backgroundTexture.ts; emitted as raw CSS because only the
// hashed asset URLs are dynamic. Opacity is a root variable so it can be tuned live
// like the color roles.
const textureRule = ({ asset, blendMode, size, repeat }: TextureSettings) =>
    `background-image: url("${asset.src}"); background-repeat: ${repeat}; background-size: ${size}; mix-blend-mode: ${blendMode};`;
const { light: lightTexture, dark: darkTexture } = backgroundTexture;
const lightRule = textureRule(lightTexture);
const darkRule = textureRule(darkTexture);
const textureCss = `@layer theme { :root { --texture-opacity: ${lightTexture.opacity}; } html.dark { --texture-opacity: ${darkTexture.opacity}; } } body::before { ${lightRule} }${darkRule === lightRule ? "" : ` html.dark body::before { ${darkRule} }`}`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <!-- Browser UI color. ThemeToggle.astro sets it from the page background once
             styles load; this is only the first-paint value. -->
        <meta name="theme-color" content={PAPER} />
        <!-- Early in <head> so the theme is set before anything paints. The stored
             choice wins; otherwise follow the system. ThemeToggle.astro writes it. -->
        <script is:inline>
            (() => {
                let stored = null;
                try {
                    stored = localStorage.getItem("theme");
                } catch {}
                const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
                document.documentElement.classList.toggle("dark", dark);
            })();
        </script>
        {import.meta.env.DEV && <ColorLab />}
        <title>{documentTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />
        {noindex && <meta name="robots" content="noindex" />}
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={shareImageUrl} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content={String(share.width)} />
        <meta property="og:image:height" content={String(share.height)} />
        {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
        {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
        <meta name="twitter:card" content="summary_large_image" />
        <!-- SVG icon with a 32px PNG fallback; apple-touch-icon covers iOS bookmarks. -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        {feeds.map((feed) => <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />)}
        <meta name="generator" content={Astro.generator} />
        <!-- All three are on every page: Playfair sets the nav wordmark and each page's
             h1. Unpreloaded it lost the race against first paint and rendered in the
             Times fallback. -->
        <Font cssVariable="--font-inter" preload={[{ style: "normal" }]} />
        <Font cssVariable="--font-source-serif" preload={[{ style: "normal" }]} />
        <Font cssVariable="--font-playfair-display" preload={[{ style: "normal" }]} />
        <!-- Before <Analytics /> so a page's LCP preload isn't queued behind its ~5KB
             inline module. -->
        <slot name="head" />
        <Analytics />
        <style set:html={textureCss}></style>
    </head>
    <body class="bg-page font-serif text-ink antialiased">
        <a
            href="#main"
            class="sr-only z-100 bg-page px-4 py-3 font-sans text-sm font-semibold text-ink underline focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
            >Skip to content</a
        >
        <div class="site-shell relative z-10" data-hero-nav={heroNav ? "" : undefined}>
            <!-- items-baseline, not items-center: the 20px Playfair wordmark and the 15px
                 Inter links have different ascent ratios, so centering their line boxes
                 leaves the links ~2.7px above the wordmark's baseline. The glyph opts out
                 via self-center — it has no baseline of its own, and below sm it would
                 otherwise become the tallest item and drag the text down with it. -->
            <nav
                aria-label="Main"
                class="site-nav sticky top-0 z-50 flex flex-wrap items-baseline gap-x-3 gap-y-2 py-3 font-sans max-sm:justify-between underline-offset-4 max-lg:bg-page sm:gap-x-6 sm:py-2 sm:text-[15px] lg:flex-col lg:items-start lg:self-start lg:pb-4 lg:pt-8">
                <!-- lg:leading-[48px] matches the page headings' text-5xl line box so both
                     columns start level at lg:pt-8. mb-6 separates the wordmark from the
                     link list below it. Sized independently of the links at every step so
                     it stays the loudest thing in the bar. -->
                <a
                    href="/"
                    class="font-playfair font-semibold hover:underline sm:text-xl lg:mb-6 lg:leading-12"
                    >JacobLDraws</a
                >
                {
                    navLinks.map(({ href, label, visibility }) => (
                        <a
                            href={href}
                            aria-current={isActive(href) ? "page" : undefined}
                            class:list={[
                                NAV_LINK_CLASS,
                                isActive(href) ? NAV_INK_CURRENT : NAV_INK_REST,
                                visibility,
                            ]}>
                            {label}
                        </a>
                    ))
                }
                <a
                    href="https://www.instagram.com/jacobldraws/"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="JacobLDraws on Instagram"
                    class="inline-flex items-center self-center hover:opacity-70 lg:self-auto">
                    <InstagramGlyph />
                </a>
                <ThemeToggle />
            </nav>
            <!-- slot goes directly in grid so each page's root element can be a grid item -->
            <slot />
        </div>
        <!-- Outside .site-shell: as a grid item it would share a stacking context with
             the sticky nav and paint underneath it. -->
        <Footer />
        <!-- Topbar over the hero (heroNav): publish its height for the hero's offset,
             and set data-nav for where it sits (see .site-nav[data-nav] above). -->
        <script is:inline>
            (() => {
                const shell = document.querySelector(".site-shell[data-hero-nav]");
                const nav = shell && shell.querySelector(".site-nav");
                const hero = shell && shell.querySelector("[data-hero]");
                if (!nav || !hero) return;
                const update = () => {
                    const pastHero = hero.getBoundingClientRect().bottom <= nav.offsetHeight;
                    nav.dataset.nav = pastHero ? "page" : scrollY > 0 ? "hero" : "top";
                };
                const measure = () => {
                    document.documentElement.style.setProperty("--topbar-h", nav.offsetHeight + "px");
                    update();
                };
                measure();
                new ResizeObserver(measure).observe(nav);
                addEventListener("scroll", update, { passive: true });
            })();
        </script>
    </body>
</html>

<style is:global>
    /* Sticky footer. position: relative anchors the body::before texture layer,
       whose values are emitted from backgroundTexture.ts in <head>. */
    body {
        position: relative;
        display: flex;
        min-height: 100vh;
        flex-direction: column;
    }

    /* Shared site container: nav track + gutter + content in one capped, centred frame. */
    .site-shell {
        display: grid;
        width: 100%;
        max-width: var(--site-max-width);
        flex: 1 0 auto;
        margin-inline: auto;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto 1fr;
    }

    /* Stops one long word in a large heading from pushing <main> wider than its track. */
    .site-shell > * {
        min-width: 0;
    }

    /*
     * Insets: the topbar carries its own gutter so its background spans the viewport;
     * .site-main insets a whole page, .site-inset a child of a full-bleed page. All
     * go to zero at lg, where the shell's padding takes over. Home uses neither.
     * Every <main> pairs mx-auto with w-full: auto inline margins on an auto-width
     * grid item mean shrink-to-fit, so without w-full the page width tracks content.
     */
    .site-nav,
    .site-main,
    .site-inset {
        padding-inline: var(--site-gutter);
    }

    /* anywhere, not break-word: only anywhere counts soft wraps toward min-content. */
    .site-main,
    .site-inset {
        overflow-wrap: anywhere;
    }

    @media (width >= 1024px) {
        .site-shell {
            /* max-content keeps the nav column exactly as wide as its longest link. */
            grid-template-columns: max-content minmax(0, 1fr);
            grid-template-rows: minmax(0, 1fr);
            /* Without this gap, content sits one gutter closer to the nav than to the
               screen edge. */
            column-gap: var(--site-gutter);
            padding-inline: var(--site-gutter);
        }

        .site-nav,
        .site-main,
        .site-inset {
            padding-inline: 0;
        }

        /* 2.25rem baseline-to-baseline pitch via row-gap rather than line-height, so
           hit areas stay link-sized and the Instagram glyph falls into rhythm. */
        .site-nav {
            row-gap: calc(2.25rem - 1.5em);
            line-height: 1.5;
        }

        /* Symmetric breathing room beside the nav, for pages that fill the track. */
        .site-gap {
            padding-inline: var(--site-nav-gap);
        }
    }

    /*
     * Below lg on a page with heroNav, the topbar shares the hero's grid row so the
     * hero runs up behind it and takes the hero's ink. data-nav (set by the script at
     * the foot of the body): "top" leaves it transparent inside the hero's frame;
     * "hero" gives it the hero's paper, so hero content scrolls under it legibly
     * without a seam; "page" returns it to the page's colours past the hero.
     */
    @media (width < 1024px) {
        .site-shell[data-hero-nav] > * {
            grid-area: 1 / 1;
        }

        .site-shell[data-hero-nav] > .site-nav {
            align-self: start;
            transition:
                background-color 0.2s,
                color 0.2s;
        }

        .site-shell[data-hero-nav] > .site-nav:not([data-nav="page"]) {
            --color-ink: var(--hero-nav-ink);
            --color-ink-muted: var(--hero-nav-ink-muted);
            background-color: var(--hero-paper);
            color: var(--hero-nav-ink);
        }

        .site-shell[data-hero-nav] > .site-nav[data-nav="top"] {
            background-color: transparent;
        }
    }

    body::before {
        position: absolute;
        z-index: -20;
        inset: 0;
        pointer-events: none;
        content: "";
        opacity: var(--texture-opacity);
    }
</style>
