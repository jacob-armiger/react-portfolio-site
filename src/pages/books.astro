---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Book from "../components/Book.astro";
import Layout from "../layouts/Layout.astro";

const collection = await getCollection("books");

const readings: CollectionEntry<"books">[] = collection.sort(
    (a: CollectionEntry<"books">, b: CollectionEntry<"books">) =>
        b.data["Date Read"].localeCompare(a.data["Date Read"])
);
---

<Layout title="Books" description="Books Jacob has read lately, with ratings and short reviews.">
    <main id="main" class="site-main page-top mx-auto w-full max-w-2xl">
        <h1 class="page-title mb-8">
            Recent Readings and Impressions
        </h1>

        <div class="grid max-w-[50em] grid-cols-1">
            {
                readings.map((book) => {
                    return <Book book={book} />;
                })
            }
        </div>
    </main>
</Layout>
