---
import { ACTION_CLASS, ACTION_OUTLINE, ACTION_SOLID } from "../config/actionClass";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Thank You">
    <main class="site-main page-top mx-auto w-full max-w-2xl">
        <h1
            class="mb-4 font-playfair text-4xl font-semibold tracking-[-0.04em] text-primary sm:text-5xl dark:text-primary-dark">
            Thank You
        </h1>
        <p class="mb-10 max-w-prose text-lg leading-relaxed text-primary/85 dark:text-primary-dark/85">
            Your message is on its way. It lands in my inbox under the subject you chose, and
            I&rsquo;ll reply to the address you gave as soon as I can. If nothing arrives, my
            reply may have been filtered &mdash; check your spam folder before assuming it got
            lost.
        </p>

        <div class="flex flex-wrap gap-3 sm:gap-4">
            <a href="/art-lessons" class:list={[ACTION_CLASS, ACTION_SOLID]}>View Lessons</a>
            <a href="/" class:list={[ACTION_CLASS, ACTION_OUTLINE]}>Return Home</a>
        </div>
    </main>
</Layout>
