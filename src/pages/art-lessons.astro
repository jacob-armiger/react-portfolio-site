---
import ContactForm from "../components/ContactForm.astro";
import { getImage, Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import heroSource from "../assets/lessons2_final.webp";
import profileImg from "../assets/profile_img.jpeg";

type ArtModule = { default: ImageMetadata };
type LessonGalleryEntry = {
    src: string;
    srcSet: string | undefined;
    width: number;
    height: number;
    alt: string;
    label: string;
};

/*
 * Covers 1x-3x of the largest rendered box (~330px at lg, ~50vw below sm).
 * Every source is at least 1680px wide, so none upscale.
 */
const lessonImageWidths = [320, 480, 660, 990];
const lessonImageSizes = "(min-width: 640px) 33vw, 50vw";

/*
 * Hero is full-bleed below lg, capped at max-w-5xl above, and zoomed to 260% below
 * sm, so the smallest entry asks for more pixels than the viewport is wide.
 */
const heroWidths = [800, 1200, 1600, 2048];
const heroSizes = "(min-width: 1024px) 1024px, (min-width: 640px) 100vw, 260vw";

/*
 * quality 70 (below default): the left 55% sits under a dark gradient and the
 * source is already lossy webp. Saves ~40% of the LCP bytes.
 */
const hero = await getImage({
    src: heroSource,
    format: "webp",
    quality: 70,
    // Caps the plain-src fallback; the source is 3377px wide.
    width: 2048,
    widths: heroWidths,
    sizes: heroSizes,
});

const artModules = import.meta.glob<ArtModule>(
    [
        "../assets/oilPaintings/2025-10-27.png",
        "../assets/digitalStudies/2026-07-06.jpeg",
        "../assets/drawings/2026-06-15.jpeg",
    ],
    { eager: true },
);

const steps: string[] = [
    "Your ability to draw is the foundation of all your work. Sharpen your approach, so you can draw any subject and do it confidently.",
    "Strengthen your grasp on painting processes and materials, whether it’s oil, digital, or any other medium.",
    "Equip yourself to make original work. I'll walk you through ideation, iteration, and execution.",
];

const lessonGallery: LessonGalleryEntry[] = await Promise.all(
    [
        {
            path: "../assets/drawings/2026-06-15.jpeg",
            alt: "Refined figure drawing",
            label: "Refine your Draftsmanship",
        },
        {
            path: "../assets/oilPaintings/2025-10-27.png",
            alt: "Oil painting",
            label: "LEARN TO PAINT",
        },
        {
            path: "../assets/digitalStudies/2026-07-06.jpeg",
            alt: "Digital painting of an athlete",
            label: "Flex your skills",
        },
    ].map(async (entry) => {
        const image = artModules[entry.path].default;
        const optimized = await getImage({
            src: image,
            format: "webp",
            quality: 82,
            widths: lessonImageWidths,
            sizes: lessonImageSizes,
        });

        return {
            src: optimized.src,
            srcSet: optimized.srcSet.attribute || undefined,
            width: (optimized.attributes.width as number) ?? image.width,
            height: (optimized.attributes.height as number) ?? image.height,
            alt: entry.alt,
            label: entry.label,
        };
    }),
);
---

<Layout title="Art Lessons">
    <!-- Preload starts the hero fetch alongside the stylesheet instead of after the
         head's inline analytics module. imagesrcset/imagesizes must match the img
         exactly, or the browser fetches a second copy. -->
    <link
        slot="head"
        rel="preload"
        as="image"
        href={hero.src}
        imagesrcset={hero.srcSet.attribute || undefined}
        imagesizes={heroSizes}
        fetchpriority="high"
    />
    <!-- No .site-main: below lg the hero bleeds edge-to-edge and the rest takes the
         gutter via .site-inset; at lg the page is capped and centered. -->
    <main class="site-gap lg:page-top mx-auto w-full lg:max-w-5xl">
        <!-- <p class="mb-4 text-left text-5xl font-bold">Art Lessons</p>

        -->

        <!-- Rounded corners only at lg, where the section is inset. -->
        <!-- An <img> rather than a background so the preload scanner finds the LCP
             element without waiting on the stylesheet. left -120% recreates the original
             framing within the 260% zoom. No decoding="async": it would let the browser
             paint a frame without the hero, delaying LCP. -->
        <section
            class="relative mb-8 h-auto w-full overflow-hidden p-4 text-secondary lg:rounded-xs">
            <img
                src={hero.src}
                srcset={hero.srcSet.attribute || undefined}
                sizes={heroSizes}
                alt=""
                fetchpriority="high"
                class="absolute left-[-120%] top-0 h-auto w-[260%] max-w-none sm:left-0 sm:h-full sm:w-full sm:object-cover sm:object-center"
            />

            <div class="pointer-events-none absolute inset-0 bg-linear-to-r from-black via-black/30 via-75% to-transparent sm:via-55%">
            </div>

            <div class=" pointer-events-none absolute inset-1 border border-[#887928]/80 mix-blend-color-dodge rounded-r-2xl">
            </div>

            <div class="relative mb-8">
                <!-- Smaller below sm so "Structure." still fits inside the gutter. -->
                <h1 class="font-playfair text-5xl font-semibold tracking-[-0.04em] sm:text-7xl">
                    Practice Boldly.<br />Get Structure.
                </h1>
            </div>

            <div class=" relative mb-4 flex w-2/3 sm:w-1/2 flex-col gap-8 text-base leading-relaxed">
                <div class="sm:border-l-2 border-secondary sm:pl-4 dark:border-primary-dark">
                    <p class="text-lg font-semibold">$50 &mdash; One hour, one-on-one</p>
                    <p class="mt-1 opacity-90">Sessions are scheduled at your convenience and as often as you like.</p>
                </div>

                <div class="sm:border-l-2 border-secondary sm:pl-4 dark:border-primary-dark">
                    <p class="text-lg font-semibold">What to Expect</p>
                    <p class="mt-1 opacity-90">
                        Hone your fundamental skills. Sessions typically include a review of your work, demonstrations, hands-on drawing time, and recommendations on what to practice at home.
                    </p>
                </div>

                <div class="sm:border-l-2 border-secondary sm:pl-4 dark:border-primary-dark">
                    <p class="text-lg font-semibold">Format</p>
                    <p class="mt-1 opacity-90">
                        Lessons are available online or in person for those local to New York City.
                    </p>
                </div>
            </div>
        </section>

        <!-- Everything after the hero takes the gutter; the hero stays full-bleed. -->
        <div class="site-inset">

        <p class="mb-8  max-w-3xl mx-auto  text-xl leading-relaxed opacity-80 text-balance text-center ">
            I offer lessons to artists of all levels &mdash; whether you’re refining your
            draftsmanship, building a portfolio for art school, or just looking for guidance on what
            to practice. This isn't just an art lesson; it's an ongoing mentorship.
        </p>

        <section class="mb-20 px-1 max-w-3xl mx-auto">
            <!-- <div class="mx-auto grid max-w-2xl grid-cols-3 gap-2 sm:gap-3"> -->
            <div class="mx-0 sm:m-auto grid w-full grid-cols-2 sm:grid-cols-3 gap-x-1 sm:gap-x-4 gap-y-4 sm:gap-y-2">
                <!-- Figures take self-start below sm: the caption column is the taller grid
                     item, and a stretched figure would leave the inset-1 rule framing empty
                     background under the artwork. At sm+ the img takes h-full, so stretching
                     is what keeps the three frames level. -->
                {
                    lessonGallery.map((piece, i) => (
                        <figure class="relative self-start sm:self-auto max-h-80 sm:max-h-none overflow-hidden bg-primary/5 dark:bg-primary-dark/5">

                            <img
                                src={piece.src}
                                srcset={piece.srcSet}
                                sizes={lessonImageSizes}
                                alt={piece.alt}
                                loading="lazy"
                                decoding="async"
                                class="w-full sm:h-full object-cover"
                            />
                            <div class="pointer-events-none absolute inset-1 border border-[#887928]/60 mix-blend-color-dodge rounded-t-full"/>

                        </figure>
                        <div class="sm:hidden text-left mx-2 place-self-center">
                            <h2 class="sm:text-nowrap mb-4 mt-0 sm:mt-2 font-medium uppercase tracking-[0.16em] opacity-100 text-xs">
                                {piece.label}
                            </h2>
                            <p class="font-sans text-balance opacity-70">{steps.at(i)}</p>
                        </div>

                    ))
                }

                {
                    steps.map((step, i) => (
                        <div class="h-fit hidden sm:block">
                            <h2 class="md:text-nowrap mb-4 mt-2 font-medium uppercase tracking-[0.16em] opacity-100 text-xs">
                                {lessonGallery.at(i)?.label}
                            </h2>
                            <p class="font-sans opacity-70">{step}</p>
                        </div>
                    ))
                }
            </div>
        </section>

        <p class="font-serif mb-20 text-xl italic leading-snug max-w-prose mx-auto text-center text-balance">
            I’ll help you solve problems in your art and in your practice by diagnosing what you
            need most, so we can work on it together.
        </p>


            <!-- Hidden on phones: the portrait and bio crowd the page before the form. -->
            <div class="hidden sm:flex flex-row max-w-3xl mb-8 mx-auto place-content-center">
                <div>
                <h2 class="mb-2 font-sans opacity-80 text-lg font-semibold tracking-[-0.04em]">
                    The Teacher
                </h2>
                <p class="text-sm leading-relaxed text-pretty opacity-60">
                    I'm a self-taught artist who went from not knowing how to draw at all to
                    competing in drawing contests and selling work in three years. Online art
                    instruction is a maze of conflicting advice and trivial exercises, but I
                    separated the wheat from the chaff to find what works. I built my training
                    around 19th-century French schooling because it replaces guesswork with the
                    cornerstones that comprise our craft: draftsmanship, painting, and storytelling.
                </p>

                </div>
                <Image
                    src={profileImg}
                    alt="Jacob, smiling in a tweed jacket"
                    widths={[144, 288, 432]}
                    sizes="(min-width: 640px) 9rem, 8rem"
                    format="webp"
                    quality={80}
                    loading="lazy"
                    class="profile-plate w-30 shrink-0 self-center object-cover object-top sm:w-36 sm:self-start"
                />
            </div>

        <div class="w-full px-2 sm:w-5/6 sm:mx-auto">
        <hr class="mb-10 border-primary opacity-20 dark:border-primary-dark" />

        <h2 class="col mb-4 text-left font-playfair text-3xl font-semibold tracking-[-0.04em]">Start Learning</h2>
        <p class="mb-8 text-base opacity-90">
            Let me know what questions you have, when you want to schedule, and what interests you.
        </p>

        <ContactForm subject="Art Lessons Inquiry" defaultSubject="Art lessons" />

        </div>
        </div>
    </main>
</Layout>

<style>
    /* Same hairline the blog cards and carousel use; --plate-rule flips in global.css. */
    .profile-plate {
        aspect-ratio: 4 / 5;
        border: 1px solid var(--plate-rule);
    }

</style>
