---
import Layout from "../layouts/Layout.astro";

// Evaluation page for the display-face swap. Every string is lifted verbatim from the
// page the face would actually set, so the comparison is on real copy at real sizes.
const HERO = "Contact me to get art lessons or commission work";
const SECTION = "What I can make.";
const LESSONS = "Practice Boldly. Get Structure.";
const ARTICLE = "A Sargent Master Study";
const BODY =
    "I've followed the training of 19th century masters to rapidly improve my skills and with my lessons you can do the same. I am also accepting commissions for digital and traditional work.";

type Candidate = {
    name: string;
    font: string;
    note: string;
    weight: string;
    // Graphic axes are the point of Workbench; without them it renders plain.
    variation?: string;
};

const CANDIDATES: Candidate[] = [
    {
        name: "Playfair Display — current",
        font: "font-playfair",
        note: "The face in place today, for reference.",
        weight: "font-extrabold",
    },
    {
        name: "Boldonse",
        font: "font-boldonse",
        note: "Single weight, no italic. Heavy poster display — the most conventionally 'graphic' of the four.",
        weight: "font-normal",
    },
    {
        name: "Workbench — default",
        font: "font-workbench",
        note: "Monospace. Home-computer/technical drawing face, BLED 0 / SCAN 0.",
        weight: "font-normal",
    },
    {
        name: "Workbench — BLED 60, SCAN 80",
        font: "font-workbench",
        note: "Ink-bleed and scanline axes pushed. This is the effect the face exists for.",
        weight: "font-normal",
        variation: "'BLED' 20, 'SCAN' 15",
    },
    {
        name: "Newsreader — 800",
        font: "font-newsreader",
        note: "Live opsz axis (6–72), driven automatically by font-size. wght 200–800, has a true italic.",
        weight: "font-extrabold",
    },
    {
        name: "Newsreader — 600",
        font: "font-newsreader",
        note: "Lighter setting; closer to the editorial register than the poster one.",
        weight: "font-semibold",
    },
    {
        name: "Young Serif",
        font: "font-youngserif",
        note: "Single weight 400, no italic. Thickest thin-strokes of anything measured — best survivor of the hero blend.",
        weight: "font-normal",
    },
    {
        name: "Petrona",
        font: "font-petrona",
        note: "A text serif, not a display face — included because you asked for it, but it is the odd one out here.",
        weight: "font-bold",
    },
];

const varStyle = (c: Candidate) =>
    c.variation ? `font-variation-settings: ${c.variation};` : undefined;
---

<Layout title="Font specimen">
    <Fragment slot="head">
        <meta name="robots" content="noindex" />
    </Fragment>

    <main class="site-main page-top mx-auto w-full max-w-5xl">
        <p class="mb-2 font-sans text-[0.7rem] font-semibold uppercase tracking-[0.3em] text-primary/60 dark:text-primary-dark/60">
            Internal
        </p>
        <h1 class="mb-3 font-serif text-4xl font-bold">Display face candidates</h1>
        <p class="mb-10 max-w-2xl font-serif text-base leading-relaxed opacity-80">
            Real strings at real sizes on the real background. Source Serif sets the body in
            every block. Delete this page once you've picked.
        </p>

        {
            CANDIDATES.map((c) => (
                <section class="mb-14 border-t border-primary/15 pt-6 dark:border-primary-dark/15">
                    <div class="mb-6 flex flex-wrap items-baseline gap-x-4 gap-y-1">
                        <h2 class="font-sans text-sm font-semibold uppercase tracking-[0.2em]">
                            {c.name}
                        </h2>
                        <p class="font-sans text-xs opacity-60">{c.note}</p>
                    </div>

                    {/* Home hero, at the size and tracking index.astro actually uses. */}
                    <p
                        class={`${c.font} ${c.weight} mb-8 leading-[1] tracking`}
                        style={`font-size: 7.5rem;${c.variation ? ` font-variation-settings: ${c.variation};` : ""}`}>
                        {HERO}
                    </p>

                    {/* Lessons hero: reversed out, since that is how it appears. */}
                    <div class="mb-8 bg-primary px-5 py-6 dark:bg-black/40">
                        <p
                            class={`${c.font} ${c.weight} text-3xl text-secondary sm:text-5xl dark:text-primary-dark`}
                            style={varStyle(c)}>
                            {LESSONS}
                        </p>
                    </div>

                    <div class="mb-6 flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-10">
                        <div class="sm:w-1/2">
                            <p class="font-sans text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-primary/70 dark:text-primary-dark/70">
                                Selected work
                            </p>
                            <p
                                class={`${c.font} ${c.weight} mt-2 text-3xl sm:text-4xl`}
                                style={varStyle(c)}>
                                {SECTION}
                            </p>
                        </div>
                        <div class="sm:w-1/2">
                            <p class={`${c.font} ${c.weight} text-2xl`} style={varStyle(c)}>
                                {ARTICLE}
                            </p>
                            <p class="mt-3 font-serif text-base leading-relaxed opacity-85">
                                {BODY}
                            </p>
                        </div>
                    </div>

                    {/* Wordmark: one string, where a display face either reads as a logo
                        or reads as a costume. */}
                    <p class={`${c.font} ${c.weight} text-xl`} style={varStyle(c)}>
                        JacobLDraws
                    </p>
                </section>
            ))
        }
    </main>
</Layout>
