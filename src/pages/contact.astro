---
import ContactForm from "../components/ContactForm.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact" description="Ask about art lessons, commission a piece, or just say hello. Jacob reads every message.">
    <main id="main" class="site-main page-top mx-auto w-full max-w-2xl">
        <h1 class="page-title mb-4">
            Contact Me
        </h1>
        <p class="mb-10 max-w-prose text-lg leading-relaxed text-ink-soft">
            Questions, commission requests, or lesson inquiries are all welcome. Tell me what
            you have in mind and I&rsquo;ll get back to you soon.
        </p>

        <ContactForm />
    </main>
</Layout>
