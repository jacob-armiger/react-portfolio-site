---
import ContactForm from "../components/ContactForm.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">
    <main class="site-main page-top mx-auto w-full max-w-2xl">
        <h1
            class="mb-4 font-playfair text-4xl font-semibold tracking-[-0.04em] text-primary sm:text-5xl dark:text-primary-dark">
            Contact Me
        </h1>
        <p class="mb-10 max-w-prose text-lg leading-relaxed text-primary/85 dark:text-primary-dark/85">
            Questions, commission requests, or lesson inquiries are all welcome. Tell me what
            you have in mind and I&rsquo;ll get back to you soon.
        </p>

        <ContactForm />
    </main>
</Layout>
