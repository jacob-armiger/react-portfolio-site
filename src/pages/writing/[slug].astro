---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
    const articles = await getCollection('article');
    return articles.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}


import Dateline from "../../components/Dateline.astro";
import Prose from "../../components/Prose.astro";
import RssFeedButton from "../../components/RssFeedButton.astro";
import Layout from "../../layouts/Layout.astro";
import { articleText, readingMinutes } from "../../utils/article";
import { imageSize } from "../../utils/originals";

const { entry } = Astro.props as { entry: CollectionEntry<"article"> };
const { Content } = await render(entry);
const readingTime = readingMinutes(articleText(entry.body));

// The 75vh cap has to reach the layout as a max-*width* on the figure: capping
// height instead leaves the img's width indefinite until the file decodes, so
// nothing is reserved and the article body drops in behind it.
const cover = imageSize(entry.data.image);
const coverCap = cover ? `max-width: calc(75vh * ${cover.width / cover.height})` : undefined;
---

<Layout title={entry.data.title ?? "Writing Post"}>
    <main class="site-main page-top mx-auto w-full max-w-2xl">
        {entry.data.image ? (
            /* coverCap makes the figure hug the image on its own, which is what keeps
               the caption aligned to the image's left edge. */
            <figure class="article-cover" style={coverCap}>
                {/* No object-contain, so the hairline traces the image rather than a
                    letterboxed box around it. */}
                <Image
                    src={entry.data.image}
                    alt={entry.data.imageAlt ?? ""}
                    width={1200}
                    format="webp"
                    quality={82}
                    loading="eager"
                    class="block h-auto w-full"
                    style={`aspect-ratio: ${cover.width} / ${cover.height}`}
                />
                {entry.data.reference ? (
                    <figcaption class="article-cover__caption font-sans">
                        After{" "}
                        {entry.data.reference_url ? (
                            <a href={entry.data.reference_url} class="underline underline-offset-2">
                                {entry.data.reference}
                            </a>
                        ) : (
                            entry.data.reference
                        )}
                    </figcaption>
                ) : null}
            </figure>
        ) : null}
        <div class="mt-3 flex justify-start">
            <RssFeedButton />
        </div>
        <header class="mt-6">
            <h1 class="font-playfair text-4xl font-semibold leading-[1.1] tracking-[-0.04em] sm:text-5xl">
                {entry.data.title}
            </h1>
            <Dateline date={entry.data.date} minutes={readingTime} class="mt-3" />
        </header>
        <div class="mt-8">
            <Prose>
                <Content />
            </Prose>
        </div>
    </main>
</Layout>

<style>
    /* No offset shadow: that is the blog card's clickable-hover affordance. */
    .article-cover :global(img) {
        border: 1px solid var(--plate-rule);
    }

    /* Shares the dateline's treatment. */
    .article-cover__caption {
        margin-top: 0.9rem;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.16em;
        opacity: 0.65;
        text-transform: uppercase;
    }
</style>
