---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import heroImage from "../assets/contactr_final.webp";
import SelectedWorkTile from "../components/SelectedWorkTile.astro";
import Layout from "../layouts/Layout.astro";
import { ACTION_BASE } from "../config/actionClass";
import { artPieceAlt } from "../utils/artPiece";
import { imageSize } from "../utils/originals";

const HERO_VARIANT_WIDTHS = [640, 760, 880, 920, 1140, 1320, 1520, 1760, 1840];
const HERO_SIZES = "(min-width: 1024px) 50vw, (min-width: 640px) 72vw, 190vw";

const HERO_BODY =
    "I've followed the training of 19th-century masters to rapidly improve my skills and build an empowering foundation of knowledge. I can help you do the same.";

// Drawn twice, once per blend layer, so both copies share text and geometry.
const HEADLINE = ["Contact me for", "art lessons or to commission work."];
const HEADLINE_CLASS =
    "hero-heading absolute z-20 font-playfair font-bold leading-[1.1] tracking-display";

const HERO_ACTION_CLASS = `${ACTION_BASE} min-h-14 px-[0.8rem] py-3 text-[0.6875rem] tracking-[0.12em] sm:w-56 sm:px-6 sm:text-[0.75rem] sm:tracking-[0.15em] lg:min-h-[3.6rem] lg:w-auto lg:px-7 lg:text-[0.875rem] lg:tracking-[0.16em]`;

const selectedWorkModules = import.meta.glob<ImageMetadata>(
    "/src/assets/selectedWork/*.{png,jpg,jpeg,webp}",
    {
        eager: true,
        import: "default",
    },
);

// Match the art page's filename ordering so both pages show the work in the same sequence.
const selectedWorks = Object.entries(selectedWorkModules)
    .sort(([pathA], [pathB]) =>
        (pathB.split("/").at(-1) ?? "").localeCompare(pathA.split("/").at(-1) ?? "", undefined, {
            numeric: true,
            sensitivity: "base",
        }),
    )
    .map(([path, image], index) => {
        const { width, height } = imageSize(image);
        const alt = artPieceAlt("selectedWork", path.split("/").at(-1)!, index);
        return { image, alt, aspectRatio: width / height };
    });

// Splits the pieces into columns that end as level as possible, keeping the
// sequence within each column. Every split is tried: 13 pieces is at most 3^13
// at build time. A piece's height per unit of column width is 1 / ratio; gap is
// the column gap in the same units.
const toColumns = (count: number, gap: number) => {
    const heights = selectedWorks.map((work) => 1 / work.aspectRatio);
    const totals = new Array(count).fill(0);
    const counts = new Array(count).fill(0);
    const pick: number[] = [];
    let best = { spread: Infinity, pick: [] as number[] };
    const place = (i: number) => {
        if (i === heights.length) {
            const ends = totals.map((total, c) => total + gap * Math.max(counts[c] - 1, 0));
            const spread = Math.max(...ends) - Math.min(...ends);
            if (spread < best.spread) best = { spread, pick: [...pick] };
            return;
        }
        for (let c = 0; c < count; c++) {
            // Columns are interchangeable until they hold something.
            if (counts[c] === 0 && c > 0 && counts[c - 1] === 0) break;
            totals[c] += heights[i];
            counts[c] += 1;
            pick.push(c);
            place(i + 1);
            pick.pop();
            counts[c] -= 1;
            totals[c] -= heights[i];
        }
    };
    place(0);
    return Array.from({ length: count }, (_, c) => selectedWorks.filter((_, i) => best.pick[i] === c));
};

// Two columns up to xl, three from xl. Both are rendered; the hidden one's lazy
// images never load.
const galleryLayouts = [
    { columns: toColumns(2, 0.025), class: "flex xl:hidden", sizes: "(min-width: 1024px) 40vw, 50vw" },
    { columns: toColumns(3, 0.035), class: "hidden xl:flex", sizes: "30vw" },
];
---

<Layout title="JacobLDraws" heroNav>
    <!-- No .site-main: the hero is full-bleed and --page-inset sets the text's left
         edge. The max-w-6xl cap only applies above 1152px. -->
    <main id="main" class="site-gap mx-auto w-full max-w-6xl overflow-clip">
        <!-- lg:pt-8 matches the nav's lg:pt-8 so the hero starts level with the wordmark. -->
        <div class="page-sections flex w-full flex-col gap-8 sm:gap-10 lg:gap-12 lg:pt-8">
            <section data-hero class="hero-section relative isolate overflow-clip bg-(--hero-paper)">
                <Picture
                    src={heroImage}
                    alt="Person reclining beside a green office chair while using a telephone"
                    formats={["avif", "webp"]}
                    fallbackFormat="webp"
                    widths={HERO_VARIANT_WIDTHS}
                    sizes={HERO_SIZES}
                    quality={80}
                    priority
                    class="absolute z-10 aspect-2693/2773 max-w-none -bottom-8 left-[calc(var(--hero-art-w)*-0.0316)] w-(--hero-art-w) sm:bottom-0 sm:left-auto sm:-right-24 md:-right-20 lg:w-[min(60%,44rem)] xl:-bottom-8 xl:-right-40 xl:w-[min(75%,50rem)] 2xl:w-[50rem]"
                />

                <h1 class:list={[HEADLINE_CLASS, "text-(--hero-headline-source) mix-blend-difference"]}>
                    {HEADLINE[0]} <br /> {HEADLINE[1]}
                </h1>
                <!-- mix-blend-color duplicate over the difference layer: keeps the luminosity
                     inversion but pins hue/saturation to the ink, preventing magenta fringing
                     over the green chair. -->
                <div
                    aria-hidden="true"
                    class:list={[HEADLINE_CLASS, "pointer-events-none select-none text-(--hero-ink) mix-blend-color"]}>
                    {HEADLINE[0]} <br /> {HEADLINE[1]}
                </div>

                <div class="hero-actions z-30 sm:absolute sm:bottom-8 sm:left-(--hero-inline-inset) lg:bottom-10">
                    <!-- Hidden below sm, where the frame is too short for body copy. -->
                    <p class="max-sm:hidden mb-6 max-w-[min(23rem,46vw)] text-[1rem] leading-[1.6] font-serif text-(--hero-body) lg:mb-7 lg:max-w-98 lg:text-[1.0625rem] lg:leading-[1.65]">
                        {HERO_BODY}
                    </p>
                    <div class="hero-buttons flex flex-wrap gap-3 max-sm:grid max-sm:w-full max-sm:grid-cols-2 sm:flex-col sm:items-start sm:gap-4 lg:flex-row lg:items-center lg:gap-5">
                        <a
                            href="/contact"
                            class:list={[
                                HERO_ACTION_CLASS,
                                "bg-(--hero-ink) text-(--hero-light) hover:bg-(--hero-ink)/85 focus-visible:outline-(--hero-ink)",
                            ]}>
                            Contact
                        </a>
                        <a
                            href="/art-lessons"
                            class:list={[
                                HERO_ACTION_CLASS,
                                "border border-(--hero-ink)/25 bg-(--hero-light)/70 text-(--hero-ink) backdrop-blur-md hover:border-(--hero-ink)/60 focus-visible:outline-(--hero-ink)",
                            ]}>
                            Learn to Draw
                        </a>
                    </div>
                </div>
            </section>

            <section aria-labelledby="selected-work-heading" class="pb-2">
                <div class="section-header max-w-xl pt-5 sm:pt-6">
                    <div class="flex flex-wrap items-baseline gap-x-4">
                        <h2 id="selected-work-heading" class="font-playfair text-[1.75rem] font-semibold tracking-display text-ink sm:text-4xl">
                            What I can make.
                        </h2>
                        <!-- Negative margin cancels the padding so the tap target grows without moving the row. -->
                        <a
                            href="/art"
                            class="eyebrow -my-4 shrink-0 py-4 font-sans uppercase text-ink-muted underline underline-offset-4 hover:text-ink">
                            See more
                        </a>
                    </div>
                </div>

                {
                    galleryLayouts.map((layout) => (
                        <div class:list={["selected-work-grid mt-6 items-start", layout.class]}>
                            {layout.columns.map((works) => (
                                <div class="selected-work-column">
                                    {works.map((work) => (
                                        <SelectedWorkTile {...work} sizes={layout.sizes} />
                                    ))}
                                </div>
                            ))}
                        </div>
                    ))
                }
            </section>
        </div>
    </main>
</Layout>

<style>
    /*
     * Shared horizontal inset: hero headline, actions and the Selected Work
     * heading all measure from this so their left edges align.
     */
    .page-sections {
        --page-inset: var(--site-gutter);
        /* Shared size/tracking for all small-caps labels on the page. Tracking widens
           as the size drops. */
        --eyebrow-size: 0.5625rem;
        --eyebrow-tracking: 0.26em;
    }

    @media (width >= 640px) {
        .page-sections {
            --eyebrow-size: 0.625rem;
            --eyebrow-tracking: 0.24em;
        }
    }

    .section-header {
        padding-inline: var(--page-inset);
    }

    .eyebrow {
        font-size: var(--eyebrow-size);
        font-weight: 500;
        line-height: 1.45;
        letter-spacing: var(--eyebrow-tracking);
    }

    /* Columns rather than justified rows: each piece keeps its own height, so no
       row ends ragged and nothing is cropped. */
    .selected-work-grid {
        --gap: 0.25rem;
        gap: var(--gap);
    }

    .selected-work-column {
        display: flex;
        min-width: 0;
        flex: 1 1 0;
        flex-direction: column;
        gap: var(--gap);
    }

    @media (width >= 640px) {
        .selected-work-grid {
            --gap: 0.5rem;
        }
    }

    @media (width >= 1024px) {
        .selected-work-grid {
            --gap: 0.75rem;
        }
    }

    /*
     * Hero layout dials, mobile-first. Only multi-consumer or calc-composed values
     * live here; single-use sizes are Tailwind classes in the markup.
     */
    .hero-section {
        /* Heading box width = font size x ratio, so line breaks stay stable across
           viewport widths (a percentage width would shift them). */
        --hero-heading-ratio: 6.75;
        --hero-heading-size: min(13vw, 3.4rem);
        /* Below lg the topbar sits over the hero (heroNav in Layout.astro); its height
           comes from Layout's script, with an estimate until that runs. */
        --hero-top-offset: var(--topbar-h, 3.125rem);
        --hero-heading-top: calc(var(--page-inset) + var(--hero-top-offset));
        /* Full bleed with a bottom hairline below lg, where only the inner rule
           frames it; the outer border joins it at lg. */
        --hero-frame-border: 0px;
        /* Absolutely-positioned children measure from the padding box; subtract the
           frame border so text stays on --page-inset. */
        --hero-inline-inset: calc(var(--page-inset) - var(--hero-frame-border));
        border: var(--hero-frame-border) solid var(--hero-rule);
        border-bottom-width: 1px;
        /* Below sm the artwork is cropped around the figure and scales with the screen
           until the headline stops growing (about 430px wide); past that the figure
           holds its size and the extra width shows more of the chair. The frame
           follows the artwork. */
        --hero-art-w: min(190vw, 51rem);
        min-height: calc(max(36rem, var(--hero-art-w) * 0.937) + var(--hero-top-offset));
    }

    /*
     * Below sm the actions are the hero's only in-flow child. The headline always
     * breaks into four lines (its width scales with its size), so they start a fixed
     * distance under it; once scrolled past, they stick under the topbar and follow
     * until the hero ends. The hero and <main> clip with overflow: clip, since hidden
     * would make them the sticky scroll container and the actions would never stick.
     */
    @media (width < 640px) {
        /* Capped at the headline's width, so on wide phones the buttons line up with
           the headline instead of stretching edge to edge. */
        .hero-actions {
            position: sticky;
            top: calc(var(--hero-top-offset) + 0.75rem);
            max-width: calc(var(--hero-heading-size) * var(--hero-heading-ratio));
            margin: calc(var(--hero-heading-top) + var(--hero-heading-size) * 1.1 * 4 + 1.5rem)
                var(--hero-inline-inset) 1.25rem;
        }
    }

    /* Inner rule of the frame: above the artwork (z-15), under the text. The
       radius subtracts the outer border width to stay concentric. */
    .hero-section::before {
        position: absolute;
        z-index: 15;
        inset: 0.25rem;
        border: 1px solid var(--hero-rule);
        border-radius: calc(1rem - var(--hero-frame-border) - 0.25rem);
        pointer-events: none;
        content: "";
    }

    .hero-heading {
        top: var(--hero-heading-top);
        /* Compensate Playfair's ~0.039em left side bearing so the painted edge lands
           on --page-inset. */
        left: calc(var(--hero-inline-inset) - (var(--hero-heading-size) * 0.039));
        width: calc(var(--hero-heading-size) * var(--hero-heading-ratio));
        font-size: var(--hero-heading-size);
    }

    @media (width >= 640px) {
        .hero-section {
            --hero-heading-ratio: 8.35;
            --hero-heading-size: min(11.2vw, 6.25rem);
            /* The 44.75rem floor keeps the bottom-anchored copy clear of the headline
               on short viewports (worst case 860-1023px wide). */
            min-height: calc(clamp(44.75rem, calc(78vh - 1.75rem), 45.75rem) + var(--hero-top-offset));
            --hero-art-w: min(72vw, 34rem);
        }
    }

    @media (width >= 768px) {
        .hero-section {
            --hero-art-w: min(66vw, 36rem);
        }
    }

    /*
     * Short landscape screens below lg (a phone or foldable on its side): the hero
     * fits one screen, the headline and artwork also scale with the height, and the
     * buttons sit in a row; the shortest drop the body copy, as phones do.
     */
    @media (640px <= width < 1024px) and (height <= 720px) {
        .hero-section {
            --hero-heading-size: min(11.2vw, 6.25rem, 12.5svh);
            --hero-art-w: min(66vw, 36rem, 92svh);
            min-height: max(26rem, 100svh);
        }

        .hero-buttons {
            flex-direction: row;
            align-items: center;
        }

        @media (height <= 560px) {
            .hero-actions p {
                display: none;
            }
        }
    }

    @media (width >= 1024px) {
        .hero-section {
            /* The sidebar nav narrows the section, so the heading cap shrinks. */
            --hero-heading-size: min(9vw, 7rem);
            --hero-top-offset: 0px;
            --hero-frame-border: 1px;
            min-height: clamp(44.25rem, calc(88vh - 1.75rem), 50.25rem);
        }
    }
</style>
