---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import heroImage from "../assets/contactr_final.webp";
import Layout from "../layouts/Layout.astro";

const HERO_VARIANT_WIDTHS = [640, 760, 880, 920, 1140, 1320, 1520, 1760, 1840];
const HERO_SIZES = "(min-width: 1024px) 50vw, (min-width: 640px) 72vw, 110vw";
const GALLERY_VARIANT_WIDTHS = [320, 480, 640, 768, 960];
const GALLERY_SIZES = "(min-width: 1024px) 28vw, (min-width: 640px) 50vw, 100vw";

const HERO_EYEBROW = "OPEN FOR TEACHING AND COMMISSIONS";
const HERO_BODY =
    "I've followed the training of 19th century masters to rapidly improve my skills and with my lessons you can do the same. I am also accepting commissions for digital and traditional work.";

// Shape and behaviour only. Size, padding and typography come from the --hero-action-* dials.
const HERO_ACTION_CLASS =
    "inline-flex items-center justify-center rounded-full sm:rounded-sm font-sans font-semibold uppercase transition-transform duration-200 hover:-translate-y-0.5 focus-visible:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4";

const selectedWorkModules = import.meta.glob<ImageMetadata>(
    "/src/assets/selectedWork/*.{png,jpg,jpeg}",
    {
        eager: true,
        import: "default",
    },
);

// Match the art page's filename ordering so its selected-work deep-link indices stay stable.
const selectedWorks = Object.entries(selectedWorkModules)
    .sort(([pathA], [pathB]) =>
        (pathB.split("/").at(-1) ?? "").localeCompare(pathA.split("/").at(-1) ?? "", undefined, {
            numeric: true,
            sensitivity: "base",
        }),
    )
    .map(([, image], index) => ({
        image,
        alt: `Selected artwork ${index + 1}`,
        href: `/art?piece=selected-work-${index}#selected-work`,
        aspectRatio: image.width / image.height,
    }));
---

<Layout title="JacobLDraws">
    <!-- No .site-main: the hero is full-bleed and its own --page-inset sets the text's
         left edge. The 6xl cap is looser than the other pages' so the splash keeps most
         of its width, and it only engages above 1152px, leaving mobile and tablet
         untouched. Safe for the hero's wrap bands: --hero-heading-size is viewport-based,
         so capping the container does not move the line breaks. -->
    <main class="site-gap mx-auto w-full max-w-6xl overflow-hidden">
        <!-- lg:pt-8 matches the nav's own lg:pt-8, so the hero's top edge starts level with
             the wordmark's line box like every other page's first block. -->
        <div class="page-sections flex w-full flex-col gap-8 sm:gap-10 lg:gap-12 lg:pt-8">
            <section class="hero-section relative isolate overflow-hidden bg-[#d7cfbe] dark:bg-[#2f2a25]">
                <p class="hero-eyebrow eyebrow absolute z-30 font-sans uppercase text-primary/70 dark:text-primary-dark/70">
                    {HERO_EYEBROW}
                </p>

                <Picture
                    src={heroImage}
                    alt="Person reclining beside a green office chair while using a telephone"
                    formats={["avif", "webp"]}
                    fallbackFormat="png"
                    widths={HERO_VARIANT_WIDTHS}
                    sizes={HERO_SIZES}
                    quality={80}
                    priority
                    class="hero-image absolute z-10 max-w-none"
                />

                <h1 class="hero-heading absolute z-20 font-playfair font-bold leading-[1.1] tracking-tighter sm:tracking-[-0.04em] text-orange-100 mix-blend-difference">
                    Contact me for <br/> art lessons or to commission work.
                </h1>
                <!-- Color-blend tint over the difference layer: keeps its luminosity inversion but
                     replaces hue/saturation with the ink's, so the headline can't go magenta where
                     it crosses the saturated green chair. Same .hero-heading geometry + later
                     sibling at the same z, so it paints exactly over the glyphs. -->
                <div
                    aria-hidden="true"
                    class="hero-heading pointer-events-none absolute z-20 select-none font-playfair font-semibold leading-[1.1] tracking-tighter text-primary mix-blend-color sm:tracking-[-0.04em] dark:text-primary-dark">
                    Contact me for <br/> art lessons or to commission work.
                </div>

                <div class="hero-actions absolute z-30">
                    <p class="hero-body font-serif text-primary/85 dark:text-primary-dark/85">
                        {HERO_BODY}
                    </p>
                    <div class="hero-action-row">
                        <a
                            href="/contact"
                            class:list={[
                                HERO_ACTION_CLASS,
                                "bg-primary text-secondary shadow-[0_16px_40px_rgba(38,41,44,0.22)] focus-visible:outline-primary dark:bg-primary-dark dark:text-secondary-dark dark:focus-visible:outline-primary-dark",
                            ]}>
                            Contact
                        </a>
                        <a
                            href="/art-lessons"
                            class:list={[
                                HERO_ACTION_CLASS,
                                "border border-primary/25 bg-secondary/70 text-primary backdrop-blur-md focus-visible:outline-primary dark:border-primary-dark/25 dark:bg-secondary-dark/70 dark:text-primary-dark dark:focus-visible:outline-primary-dark",
                            ]}>
                            Learn to Draw
                        </a>
                    </div>
                </div>
            </section>

            <section aria-labelledby="selected-work-heading" class="pb-2">
                <div class="section-header flex flex-wrap items-end justify-between gap-x-4 gap-y-2 border-t border-primary/10 pt-5 sm:gap-x-6 sm:pt-6 dark:border-primary-dark/10">
                    <div class="max-w-xl">
                        <p class="eyebrow font-sans uppercase text-primary/70 dark:text-primary-dark/70">
                            Selected work
                        </p>
                        <h2 id="selected-work-heading" class="mt-2 font-playfair text-[1.75rem] font-semibold tracking-[-0.04em] text-primary sm:text-4xl dark:text-primary-dark">
                            What I can make.
                        </h2>
                    </div>
                    <!-- py-4/-my-4 grows the tap target past 44px without moving the row. -->
                    <a
                        href="/art"
                        class="eyebrow -my-4 shrink-0 py-4 font-sans uppercase text-primary/70 underline-offset-4 transition-colors hover:text-primary hover:underline dark:text-primary-dark/70 dark:hover:text-primary-dark">
                        See all work
                    </a>
                </div>

                <!-- gap-1 below sm is load-bearing, not a taste call: the tiles' flex-basis is
                     ratio-driven, and at 375px the widest pair (1.008 + 0.775) clears two-up by
                     0px. Any larger gap drops them to one-up at full width. -->
                <div class="selected-work-grid mt-6 flex flex-wrap items-start gap-1 sm:gap-3">
                    {
                        selectedWorks.map(({ image, alt, href, aspectRatio }) => (
                            <a
                                href={href}
                                style={`--tile-ratio: ${aspectRatio}; --tile-width-mobile: ${aspectRatio * 13}rem; --tile-width-tablet: ${aspectRatio * 17}rem; --tile-width-desktop: ${aspectRatio * 20}rem;`}
                                class="selected-work-tile group block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary dark:focus-visible:outline-primary-dark"
                                aria-label={`View ${alt} on the art page`}>
                                <Picture
                                    src={image}
                                    alt={alt}
                                    formats={["avif", "webp"]}
                                    widths={GALLERY_VARIANT_WIDTHS}
                                    sizes={GALLERY_SIZES}
                                    quality={78}
                                    loading="lazy"
                                    decoding="async"
                                    class="block h-full w-full object-contain transition-transform duration-1000 ease-in-out group-hover:scale-[1.01]"
                                />
                            </a>
                        ))
                    }
                </div>
            </section>
        </div>
    </main>
</Layout>

<style>
    /*
     * One horizontal inset for the whole page. The hero eyebrow, hero headline, hero actions and
     * the Selected Work heading all measure from this, so their left edges line up down the page.
     */
    .page-sections {
        /* From the shell, so the hero's text edge and every other page's content edge
           are the same value by construction. */
        --page-inset: var(--site-gutter);
    }

    .section-header {
        padding-inline: var(--page-inset);
    }

    /*
     * One token for every small caps label on the page -- hero eyebrow, Selected Work
     * kicker, See all work. They are peers, so they share a size, tracking and weight
     * rather than each picking one. Tracking opens as the size drops; below ~9px the
     * caps need it to stay separable.
     */
    .page-sections {
        --eyebrow-size: 0.5625rem;
        --eyebrow-tracking: 0.26em;
    }

    @media (min-width: 640px) {
        .page-sections {
            --eyebrow-size: 0.625rem;
            --eyebrow-tracking: 0.24em;
        }
    }

    .eyebrow {
        font-size: var(--eyebrow-size);
        font-weight: 500;
        line-height: 1.45;
        letter-spacing: var(--eyebrow-tracking);
    }

    /*
     * Justified rows start from each image's ideal width, then share remaining space
     * in proportion to aspect ratio. Images stay uncropped, every complete row fills
     * the container, and rows can resolve to different heights.
     */
    .selected-work-grid::after {
        flex: 999 1 13rem;
        content: "";
    }

    .selected-work-tile {
        max-width: 100%;
        aspect-ratio: var(--tile-ratio);
        flex-grow: var(--tile-ratio);
        flex-shrink: 1;
        flex-basis: var(--tile-width-mobile);
    }

    @media (min-width: 640px) {
        .selected-work-grid::after {
            flex-basis: 17rem;
        }

        .selected-work-tile {
            flex-basis: var(--tile-width-tablet);
        }
    }

    @media (min-width: 1024px) {
        .selected-work-grid::after {
            flex-basis: 20rem;
        }

        .selected-work-tile {
            flex-basis: var(--tile-width-desktop);
        }
    }

    /* Shared hero controls. Breakpoints override these values without changing the composition rules. */
    .hero-section {
        --hero-image-top: 6.5rem;
        --hero-image-bottom: auto;
        --hero-image-left: 48%;
        --hero-image-right: auto;
        --hero-image-width: 42rem;
        --hero-image-transform: translateX(-56%);
        --hero-heading-size: clamp(2.65rem, 11.5vw, 4rem);
        /*
         * Wrap dial. The heading box width is derived from the font size, so the line breaks stay
         * identical at every viewport width instead of drifting with a percentage width.
         * Measured in Playfair Display at tracking -0.05em, the safe bands are:
         *   4 lines (Contact me to / get art lessons / or commission / work) -> 6.15 to 7.14
         *   3 lines (Contact me to get / art lessons or / commission work)   -> 7.37 to 8.50
         * Re-measure these bands if the headline copy or letter-spacing changes.
         */
        --hero-heading-ratio: 6.4;
        /*
         * Vertical rhythm. The headline is stacked under the eyebrow's line box, so changing the
         * inset or the eyebrow's leading keeps the pair together instead of drifting apart.
         */
        /* Derived from the shared eyebrow scale so the headline restacks itself
           whenever that size changes. 1.45 is .eyebrow's line-height. */
        --hero-eyebrow-line: calc(var(--eyebrow-size) * 1.45);
        --hero-eyebrow-gap: 1rem;
        --hero-heading-top: calc(
            var(--page-inset) + var(--hero-eyebrow-line) + var(--hero-eyebrow-gap)
        );
        /*
         * Playfair's cap carries ~0.039em of left side bearing. Pulling the box left by that much
         * puts the painted edge of the headline on --page-inset, level with the eyebrow and the
         * Selected Work heading below.
         */
        --hero-heading-optical-pull: calc(var(--hero-heading-size) * 0.039);
        --hero-heading-left: var(--hero-inline-inset);
        --hero-body-width: 23rem;
        /* Source Serif runs optically smaller than Inter at the same px, so the lead sits
           a step above where it did as sans. Measure stays ~58 characters. */
        --hero-body-size: 1rem;
        --hero-body-leading: 1.6;
        --hero-body-gap: 1.5rem;
        /*
         * Deliberately larger than the eyebrow's top inset: the bottom cluster is a 60px
         * button block, and matching the 16px top inset left it kissing the frame edge.
         */
        --hero-actions-bottom: 1.5rem;
        --hero-actions-left: var(--hero-inline-inset);
        --hero-action-gap: 0.75rem;
        --hero-action-min-h: 3.5rem;
        --hero-action-px: 1.25rem;
        --hero-action-font-size: 0.75rem;
        --hero-action-tracking: 0.2em;
        /* Double-rule frame. Both rules live here rather than on a Tailwind border
           utility so the inner one can subtract the outer's width and stay
           concentric through the corner. Below lg the panel is full bleed; the
           card margin comes out of --hero-inline-inset so the text's screen-x
           stays aligned with the Selected Work heading. */
        --hero-frame-radius: 0rem;
        --hero-frame-border: 1px;
        --hero-frame-gap: 0.25rem;
        --hero-frame-margin: 0rem;
        /* Absolutely-positioned children measure from the padding box, so the frame's
           own width has to come back out or the text sits inboard of the heading. */
        --hero-inline-inset: calc(
            var(--page-inset) - var(--hero-frame-margin) - var(--hero-frame-border)
        );
        --hero-frame-line: rgba(42, 35, 27, 0.15);
        margin-inline: var(--hero-frame-margin);
        border: var(--hero-frame-border) solid var(--hero-frame-line);
        border-radius: var(--hero-frame-radius);
        min-height: clamp(42rem, 88vh, 50rem);
        background-image:
            linear-gradient(105deg, rgba(63, 81, 59, 0.13), transparent 38%),
            linear-gradient(315deg, rgba(141, 189, 182, 0.12), transparent 42%);
    }

    .hero-eyebrow {
        top: var(--page-inset);
        left: var(--hero-inline-inset);
    }

    /* Inner rule of the double frame: above the artwork (z-15 > image's z-10),
       under the text layers. */
    .hero-section::before {
        position: absolute;
        z-index: 15;
        inset: var(--hero-frame-gap);
        border: 1px solid var(--hero-frame-line);
        border-radius: calc(
            1rem - var(--hero-frame-border) - var(--hero-frame-gap)
        );
        pointer-events: none;
        content: "";
    }

    .hero-image {
        top: var(--hero-image-top);
        right: var(--hero-image-right);
        bottom: var(--hero-image-bottom);
        left: var(--hero-image-left);
        width: var(--hero-image-width);
        aspect-ratio: 2693 / 2773;
        transform: var(--hero-image-transform);
    }

    .hero-heading {
        top: var(--hero-heading-top);
        left: calc(var(--hero-heading-left) - var(--hero-heading-optical-pull));
        width: calc(var(--hero-heading-size) * var(--hero-heading-ratio));
        font-size: var(--hero-heading-size);
    }

    .hero-body {
        max-width: var(--hero-body-width);
        margin-bottom: var(--hero-body-gap);
        font-size: var(--hero-body-size);
        line-height: var(--hero-body-leading);
    }

    .hero-actions {
        bottom: var(--hero-actions-bottom);
        left: var(--hero-actions-left);
    }

    .hero-action-row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--hero-action-gap);
    }

    .hero-actions a {
        min-height: var(--hero-action-min-h);
        padding-block: 0.75rem;
        padding-inline: var(--hero-action-px);
        font-size: var(--hero-action-font-size);
        letter-spacing: var(--hero-action-tracking);
    }

    /* Mobile: headline first, a controlled artwork crop, then the actions. */
    @media (max-width: 639px) {
        .hero-section {
            --hero-eyebrow-gap: 1rem;
            --hero-heading-ratio: 6.4;
            --hero-heading-size: min(14vw, 3.55rem);
            --hero-image-top: 7rem;
            --hero-image-bottom: auto;
            --hero-image-left: 60%;
            --hero-image-right: auto;
            --hero-image-width: 29rem;
            --hero-image-transform: translateX(-48%);
            --hero-action-gap: 0.75rem;
            --hero-action-min-h: 3.5rem;
            --hero-action-px: 0.8rem;
            --hero-action-font-size: 0.6875rem;
            --hero-action-tracking: 0.12em;
            min-height: 43rem;
        }

        .hero-eyebrow {
            max-width: calc(100% - (2 * var(--hero-inline-inset)));
        }

        /* The intro copy is dropped so the shorter frame can breathe. */
        .hero-body {
            display: none;
        }

        .hero-actions {
            right: var(--hero-inline-inset);
        }

        .hero-action-row {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            width: 100%;
        }
    }

    /* Horizontal navigation layouts sit flush against the nav divider. */
    @media (min-width: 640px) {
        .hero-section {
            --hero-eyebrow-gap: 1rem;
            --hero-heading-ratio: 7.9;
            --hero-heading-size: min(11.6vw, 6.25rem);
            --hero-image-top: auto;
            --hero-image-bottom: 0;
            --hero-image-left: auto;
            --hero-image-right: -6rem;
            --hero-image-width: min(72vw, 34rem);
            --hero-image-transform: none;
            --hero-body-width: 23rem;
            --hero-body-gap: 1.5rem;
            --hero-actions-bottom: 2rem;
            --hero-action-gap: 1rem;
            --hero-action-min-h: 3.5rem;
            --hero-action-px: 1.5rem;
            --hero-action-font-size: 0.75rem;
            --hero-action-tracking: 0.15em;
            /*
             * The floor is what keeps the bottom-anchored copy clear of the headline at the top of
             * this band, where the headline is at its 6.25rem cap but the frame is shortest. Sized
             * for the serif lead: 43rem left the two overlapping at 860-1023px on short screens.
             */
            min-height: clamp(46.5rem, 78vh, 47.5rem);
        }

        /* Stacked, equal-width actions read as a single column beside the artwork. */
        .hero-action-row {
            flex-direction: column;
            align-items: flex-start;
        }

        .hero-actions a {
            width: 14rem;
        }
    }

    /* Full bleed until the sidebar layout: the panel runs to both screen edges, so
       the framed-card treatment (and its inner rule, which reads broken without a
       top edge) is held back for lg. A hairline closes the panel at the bottom. */
    @media (max-width: 1023px) {
        .hero-section {
            --hero-frame-margin: 0rem;
            --hero-frame-radius: 0;
            --hero-frame-border: 0px;
            border-bottom-width: 1px;
        }

        .hero-section::before {
            content: none;
        }
    }

    @media (min-width: 768px) {
        .hero-section {
            --hero-image-right: -5rem;
            --hero-image-width: min(66vw, 36rem);
        }
    }

    /* Desktop sidebar layout restores the framed poster treatment. */
    @media (min-width: 1024px) {
        .hero-section {
            /* The sidebar nav narrows the section here, so the headline needs a smaller cap. */
            --hero-heading-size: min(9.6vw, 7rem);
            --hero-image-top: auto;
            --hero-image-bottom: 0rem;
            --hero-image-right: -5rem;
            --hero-image-width: min(60%, 44rem);
            --hero-body-width: 24.5rem;
            --hero-body-size: 1.0625rem;
            --hero-body-leading: 1.65;
            --hero-body-gap: 1.75rem;
            --hero-actions-bottom: 2.5rem;
            --hero-action-gap: 1.25rem;
            --hero-action-min-h: 3.6rem;
            --hero-action-px: 1.75rem;
            --hero-action-font-size: 0.875rem;
            /* 0.2em read as a tracked-out label rather than a button; this sits with the
               footer's 0.18em while staying open enough for uppercase Inter. */
            --hero-action-tracking: 0.16em;
            min-height: clamp(46rem, 88vh, 52rem);
        }

        .hero-action-row {
            flex-direction: row;
            align-items: center;
        }

        .hero-actions a {
            width: auto;
        }
    }

    @media (min-width: 1280px) {
        .hero-section {
            --hero-image-bottom: -2rem;
            --hero-image-right: -10rem;
            --hero-image-width: min(75%, 50rem);
        }
    }

    /* Cap the composition on very wide screens rather than continuing to scale it. */
    @media (min-width: 1536px) {
        .hero-section {
            --hero-image-bottom: -2rem;
            --hero-image-right: -10rem;
            --hero-image-width: 50rem;
        }
    }

    /*
     * Preserve the image-derived olive and telephone-blue atmosphere in dark mode.
     * Keyed to html.dark rather than (prefers-color-scheme: dark) because the site's
     * dark mode is class-based; the OS preference alone would paint these gradients
     * over an otherwise light page.
     */
    :global(html.dark) .hero-section {
        --hero-frame-line: rgba(229, 226, 218, 0.15);
        background-image:
            linear-gradient(105deg, rgba(92, 119, 86, 0.18), transparent 38%),
            linear-gradient(315deg, rgba(141, 189, 182, 0.1), transparent 42%);
    }
</style>
