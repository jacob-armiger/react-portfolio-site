---
/*
 * Site footer, rendered on every page from Layout.astro.
 * Keep the link row complete: the topbar hides BOOKS below md and DIRECTORY
 * below sm, so this is the only route to those pages on a phone.
 */

const year = new Date().getFullYear();

const LINKS = [
    { href: "/art-lessons", label: "Lessons" },
    { href: "/art", label: "Art" },
    { href: "/writing", label: "Blog" },
    { href: "/books", label: "Books" },
    { href: "/directory", label: "Directory" },
    { href: "/contact", label: "Contact" },
    { href: "https://www.instagram.com/jacobldraws/", label: "Instagram", external: true },
    { href: "/writing/rss.xml", label: "RSS" },
];

const LINK_CLASS =
    "underline-offset-4 hover:text-primary hover:underline focus-visible:underline focus-visible:outline-hidden dark:hover:text-primary-dark";
---

<!-- Full-width band under the shell, sharing its max-width and gutters. -->
<footer
    class="mx-auto mt-20 w-full max-w-(--site-max-width) flex-none border-t border-primary/15 px-(--site-gutter) py-10 font-sans wrap-anywhere lg:mt-28 dark:border-primary-dark/15">
    <div
        class="flex flex-col gap-5 text-sm text-primary/70 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8 dark:text-primary-dark/70">
        <nav aria-label="Footer">
            <ul class="flex flex-wrap gap-x-5 gap-y-2">
                {
                    LINKS.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class={LINK_CLASS}
                                target={link.external ? "_blank" : undefined}
                                rel={link.external ? "noopener noreferrer" : undefined}>
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
        <p class="shrink-0 text-xs text-primary/55 dark:text-primary-dark/55">
            &copy; {year} JacobLDraws. All artwork rights reserved.
        </p>
    </div>
</footer>
