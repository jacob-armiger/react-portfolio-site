---
/*
 * Site footer, rendered on every page from Layout.astro.
 * Keep the link row complete: the topbar hides BOOKS below md and DIRECTORY
 * below sm, so this is the only route to those pages on a phone.
 */

const year = new Date().getFullYear();

const LINKS = [
    { href: "/contact", label: "Contact me", emphasis: true },
    { href: "/art-lessons", label: "Lessons" },
    { href: "/art", label: "Art" },
    { href: "/writing", label: "Blog" },
    { href: "/books", label: "Books" },
    { href: "/directory", label: "Directory" },
    { href: "https://www.instagram.com/jacobldraws/", label: "Instagram", external: true },
    { href: "/feed/rss.xml", label: "RSS" },
];

const LINK_CLASS =
    "underline-offset-4 hover:text-ink hover:underline focus-visible:underline";
// The one action in the row: full ink and a standing underline, so it reads first
// without breaking the line of plain links.
const EMPHASIS_CLASS = "font-medium text-ink underline decoration-underline hover:decoration-ink";
---

<!-- Full-width band under the shell, sharing its max-width and gutters. The lg
     right padding grows only when the side margin is too narrow to clear the fixed
     theme toggle. -->
<footer
    class="mx-auto mt-20 w-full max-w-(--site-max-width) flex-none border-t border-rule px-(--site-gutter) py-10 font-sans wrap-anywhere lg:mt-28 lg:pr-[max(var(--site-gutter),calc(4.5rem_-_(100vw_-_var(--site-max-width))/2))]">
    <div
        class="flex flex-col gap-5 text-sm text-ink-muted sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
        <nav aria-label="Footer">
            <ul class="flex flex-wrap gap-x-5 gap-y-2">
                {
                    LINKS.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class:list={[LINK_CLASS, link.emphasis && EMPHASIS_CLASS]}
                                target={link.external ? "_blank" : undefined}
                                rel={link.external ? "noopener noreferrer" : undefined}>
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
        <p class="shrink-0 text-xs text-ink-muted">
            &copy; {year} JacobLDraws. All artwork rights reserved.
        </p>
    </div>
</footer>
