---
// https://jahir.dev/blog/astro-reading-time
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { articleText, readingMinutes } from "../utils/article";
import Dateline from "./Dateline.astro";

interface Props {
    art: CollectionEntry<"article">;
    /** Lead story: display headline beside the plate, excerpt spanning underneath. */
    featured?: boolean;
}

const { art, featured = false } = Astro.props;
const excerpt = articleText(art.body);
const readingTime = readingMinutes(excerpt);
---

<a
    href={"/writing/" + art.id}
    class:list={["blog-card group block", featured && "blog-card--featured", "relative"]}>

    <article class="blog-card__grid">

        <!-- Hairline rule directly on the image, no mat: the edge stays a single
             crisp line at any zoom. -->
        <figure class="blog-card__plate">
            <Image
                src={art.data.image}
                alt=""
                width={featured ? 750 : 560}
                format="webp"
                quality={80}
                class:list={[
                    "h-full object-cover object-[50%_10%]",
                    featured ? "aspect-[3/2] sm:aspect-[4/3]" : "aspect-[3/2] sm:aspect-[4/5]",
                ]}
            />
        </figure>


        <div class="blog-card__head">
            <Dateline date={art.data.date} minutes={readingTime} />

            <h2
                class:list={[
                    "mt-2 font-serif font-bold leading-[1.15] tracking-tight decoration-[1.5px] underline-offset-[6px] group-hover:underline",
                    featured ? "text-4xl md:text-6xl" : "text-2xl",
                ]}>
                {art.data.title}
            </h2>

            {
                art.data.reference ? (
                    <p class="mt-1 font-serif text-sm italic opacity-70">
                        After {art.data.reference}
                    </p>
                ) : null
            }
        </div>

        {featured && <div class="absolute inset-1 border border-[#887928]/80 mix-blend-overlay rounded-tr-[2rem]"></div>}
        <div class="blog-card__body">
            <p
                class:list={[
                    "blog-card__excerpt line-clamp-3 font-serif text-[15px] leading-relaxed opacity-80",
                    featured && "sm:text-base",
                ]}>
                {excerpt}
            </p>

            <p class="blog-card__more font-sans">
                Continue reading <span aria-hidden="true">&rarr;</span>
            </p>
        </div>
    </article>
</a>

<style>
    /*
     * A sheet, not a panel: 1px rule all the way round and a hard offset shadow - zero
     * blur - so the card reads as a physical thing lifted off the page and every edge
     * stays a single pixel. No fill, so the body texture stays continuous underneath.
     */
    .blog-card {
        display: block;
        padding: 1.25rem;
        border: 1px solid rgb(42 35 27 / 0.55);
        background-color: transparent;
        /* Shadow, hover border and hover arrow all take the layout's plate accent,
           shared with the article cover so both themes come from one token. */
        box-shadow: 6px 6px 0 var(--plate-accent);
        transition:
            box-shadow 120ms ease-out,
            transform 120ms ease-out;
    }

    /* Hover presses the sheet down: it slides toward its shadow and the shadow
       shortens by the same amount, so the bottom-right corner stays put. */
    .blog-card:hover {
        border-color: var(--plate-accent);
        box-shadow: 2px 2px 0 var(--plate-accent);
        transform: translate(4px, 4px);
    }

    @media (min-width: 640px) {
        .blog-card {
            padding: 1.5rem;
        }

        .blog-card--featured {
            padding: 1rem;
        }
    }

    /*
     * Three blocks -- plate, head (dateline + title), body (excerpt + more) -- placed
     * by name so each card shape is one grid-template-areas line rather than a
     * different DOM per variant. Stacked on phones for both shapes.
     */
    .blog-card__grid {
        display: grid;
        gap: 1rem 1rem;
        grid-template-areas:
            "plate"
            "head"
            "body";
        grid-template-columns: minmax(0, 1fr);
    }

    .blog-card__plate {
        grid-area: plate;
    }

    .blog-card__head {
        grid-area: head;
    }

    .blog-card__body {
        display: flex;
        flex-direction: column;
        grid-area: body;
    }

    @media (min-width: 640px) {
        /* Digest entry: plate beside a full-height text column. The 1fr body row is what
           lets .blog-card__more pin to the plate's bottom edge. */
        .blog-card:not(.blog-card--featured) .blog-card__grid {
            grid-template-areas:
                "plate head"
                "plate body";
            grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
            grid-template-rows: auto 1fr;
        }

        /* Lead story: title and plate share the top row, excerpt runs underneath both.
           The split is what sets the card's proportions -- the plate is h-full, so the
           row height is the title's alone. At 1.6fr the 60px headline holds three lines
           instead of four, which is ~70px off the card. */
        .blog-card--featured .blog-card__grid {
            grid-template-areas:
                "head  plate"
                "body  body";
            grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
        }

        /* The title block is much shorter than the plate beside it; centring keeps the
           pair reading as one unit instead of a headline stranded at the top. */
        .blog-card--featured .blog-card__head {
            align-self: center;
        }

        /*
         * Digest entry: the plate's aspect ratio makes it taller than the text beside it,
         * so a fixed three-line clamp left dead space above "Continue reading". Growing
         * into the row and clipping by height fills it exactly, whatever the title's line
         * count -- the clamp can't, since it is blind to how much room is left.
         */
        .blog-card:not(.blog-card--featured) .blog-card__excerpt {
            display: block;
            flex: 1 1 0;
            overflow: hidden;
            /* Feathered bottom instead of an ellipsis: the cut lands mid-line here, and a
               hard edge would read as a rendering fault rather than as more text. */
            -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 2.25em), transparent);
            mask-image: linear-gradient(to bottom, #000 calc(100% - 2.25em), transparent);
        }
    }

    @media (min-width: 768px) {
        .blog-card:not(.blog-card--featured) .blog-card__grid {
            grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
        }
    }

    :global(html.dark) .blog-card {
        border-color: rgb(229 226 218 / 0.4);
    }

    /* Hairline only - a second hard shadow would fight the sheet's own. */
    .blog-card__plate {
        border: 1px solid var(--plate-rule);
        line-height: 0;
    }

    .blog-card__more {
        /* Pinned to the bottom of the text column so every entry ends on the same
           line however short its excerpt is. */
        margin-top: auto;
        padding-top: 0.9rem;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.14em;
        opacity: 0.6;
        text-transform: uppercase;
        transition: opacity 150ms ease;
    }

    .blog-card:hover .blog-card__more {
        opacity: 1;
    }

    .blog-card__more span {
        display: inline-block;
        transition:
            transform 200ms ease,
            color 150ms ease;
    }

    .blog-card:hover .blog-card__more span {
        color: var(--plate-accent);
        transform: translateX(3px);
    }

    @media (prefers-reduced-motion: reduce) {
        .blog-card,
        .blog-card__more,
        .blog-card__more span {
            transition: none;
        }

        /* Keep the shadow change - it is the affordance - but drop the movement. */
        .blog-card:hover,
        .blog-card:hover .blog-card__more span {
            transform: none;
        }
    }
</style>
