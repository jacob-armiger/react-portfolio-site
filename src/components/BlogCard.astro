---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { articleText, readingMinutes } from "../utils/article";
import Dateline from "./Dateline.astro";

interface Props {
    art: CollectionEntry<"article">;
    /** Larger lead-story layout: headline beside the plate, excerpt underneath. */
    featured?: boolean;
}

const { art, featured = false } = Astro.props;
const excerpt = articleText(art.body);
const readingTime = readingMinutes(excerpt);
---

<a
    href={"/writing/" + art.id}
    class:list={[
        "blog-entry group relative block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink",
        featured && "blog-entry--featured",
    ]}>
    {
        featured && (
            <div
                aria-hidden="true"
                class="blog-entry__frame pointer-events-none absolute rounded-tr-[2rem] border border-(--accent-gold)/80 mix-blend-overlay dark:border-(--accent-gold-dark)/24 dark:mix-blend-normal"
            />
        )
    }
    <article class="blog-entry__grid">
        <!-- 1px rule directly on the image, no mat, so the edge stays crisp at any zoom. -->
        <figure class="blog-entry__plate border border-plate">
            <Image
                src={art.data.image}
                alt=""
                width={featured ? 750 : 560}
                format="webp"
                quality={80}
                priority={featured}
                class:list={[
                    "h-full object-cover object-[50%_10%]",
                    featured ? "aspect-3/2 sm:aspect-4/3" : "aspect-3/2 sm:aspect-4/5",
                ]}
            />
        </figure>

        <div class="blog-entry__head">
            <Dateline date={art.data.date} minutes={readingTime} />

            <h2
                class:list={[
                    "mt-2 font-serif font-bold leading-[1.15] group-hover:opacity-60 group-focus-visible:opacity-60",
                    featured ? "text-4xl sm:text-5xl md:text-6xl" : "text-2xl",
                ]}>
                {art.data.title}
            </h2>

            {
                art.data.reference ? (
                    <p class="mt-1 font-serif text-sm italic text-ink-muted">
                        After {art.data.reference}
                    </p>
                ) : null
            }
        </div>

        <div class="blog-entry__body">
            <p
                class:list={[
                    "blog-entry__excerpt line-clamp-3 font-serif text-[15px] leading-relaxed text-ink-soft",
                    featured && "sm:text-base",
                ]}>
                {excerpt}
            </p>
        </div>
    </article>
</a>

<style>
    /* A hairline under each post, --entry-gap from its content. */
    .blog-entry {
        --entry-gap: 2rem;
        padding-block: var(--entry-gap);
        border-bottom: 1px solid var(--color-rule);
    }

    /* The featured post's content sits in a gold frame, which stands where other
       posts' content does: flush at the top and --entry-gap above the hairline. */
    .blog-entry--featured {
        --frame-pad: 1.25rem;
        padding: var(--frame-pad) var(--frame-pad) calc(var(--frame-pad) + var(--entry-gap));
    }

    .blog-entry__frame {
        inset: 0 0 var(--entry-gap);
    }

    @media (width >= 640px) {
        .blog-entry {
            --entry-gap: 2.5rem;
        }

        .blog-entry--featured {
            --frame-pad: 1.5rem;
        }
    }

    /*
     * Named areas (plate / head / body) so each variant is one
     * grid-template-areas line instead of a different DOM.
     */
    .blog-entry__grid {
        display: grid;
        gap: 1rem;
        grid-template-areas:
            "plate"
            "head"
            "body";
        grid-template-columns: minmax(0, 1fr);
    }

    .blog-entry__plate {
        grid-area: plate;
        line-height: 0;
    }

    .blog-entry__head {
        grid-area: head;
    }

    .blog-entry__body {
        display: flex;
        flex-direction: column;
        grid-area: body;
    }

    @media (width >= 640px) {
        /* Plate beside a full-height text column. */
        .blog-entry:not(.blog-entry--featured) .blog-entry__grid {
            grid-template-areas:
                "plate head"
                "plate body";
            grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
            grid-template-rows: auto 1fr;
        }

        /* Featured: title and plate share the top row, excerpt spans below.
           1.6fr keeps the 60px headline to three lines. */
        .blog-entry--featured .blog-entry__grid {
            grid-template-areas:
                "head  plate"
                "body  body";
            grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
        }

        /* Below md the headline is too short to fill the row, so centering drifts it
           down as the plate grows; pin it to the plate's top edge instead. */
        .blog-entry--featured .blog-entry__head {
            align-self: start;
        }

        /*
         * The excerpt fills the row and clips by height, so it always matches the
         * plate height regardless of title line count (a fixed line clamp leaves
         * dead space).
         */
        .blog-entry:not(.blog-entry--featured) .blog-entry__excerpt {
            display: block;
            flex: 1 1 0;
            overflow: hidden;
            /* Fade the bottom instead of an ellipsis: the clip lands mid-line. */
            -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 2.25em), transparent);
            mask-image: linear-gradient(to bottom, #000 calc(100% - 2.25em), transparent);
        }
    }

    @media (width >= 768px) {
        .blog-entry:not(.blog-entry--featured) .blog-entry__grid {
            grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
        }

        /* Center the short title block against the taller plate. */
        .blog-entry--featured .blog-entry__head {
            align-self: center;
        }
    }
</style>
