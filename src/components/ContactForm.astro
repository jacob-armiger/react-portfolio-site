---
import { ACTION_CLASS, ACTION_SOLID } from "../config/actionClass";

interface Props {
    subject?: string;
    /** Preselects the subject; the contact page leaves it unset so the field starts blank. */
    defaultSubject?: string;
    submitLabel?: string;
    redirectPath?: string;
}

const INTENTS = [
    {
        label: "Art lessons",
        placeholder:
            "Your current experience, interests, and when you want to start lessons.",
    },
    {
        label: "Commission",
        placeholder:
            "What you'd like made and the size or format you have in mind.",
    },
    { label: "Something else", placeholder: "What's on your mind?" },
] as const;

const {
    subject = "Website Contact",
    defaultSubject = "",
    submitLabel = "Send",
    redirectPath = "/submit",
} = Astro.props;

const BLANK_PLACEHOLDER = "What's on your mind?";
const selectedPlaceholder =
    INTENTS.find((intent) => intent.label === defaultSubject)?.placeholder ?? BLANK_PLACEHOLDER;

const fallbackNextUrl = new URL(redirectPath, Astro.site ?? Astro.url).toString();

const LABEL_CLASS = "text-[15px] font-semibold text-ink";
// Open boxes on the paper, square like the site's buttons, ruled with a 1px line. /55 keeps the
// edge at 3:1 against the paper (WCAG non-text contrast), the darkest of the site's rules.
// Text controls show :focus-visible on mouse click too, so a soft ring would flash on every
// click; focus instead doubles the rule to 2px of full ink. Every state change is instant.
const FIELD_CLASS =
    "w-full rounded-xs border border-field bg-page px-3 py-2.5 text-lg leading-snug text-ink outline-none placeholder:text-base placeholder:text-ink-muted hover:border-ink focus:border-ink focus:ring-1 focus:ring-ink aria-[invalid=true]:border-red-700 aria-[invalid=true]:focus:ring-red-700 dark:aria-[invalid=true]:border-red-400 dark:aria-[invalid=true]:focus:ring-red-400";
const ERROR_CLASS = "hidden text-sm font-medium text-red-700 dark:text-red-400";

const lessonsDefault = defaultSubject === INTENTS[0].label;
---

<form
    action="https://formsubmit.co/jacobldraws@icloud.com"
    method="POST"
    novalidate
    class="flex flex-col gap-9 font-sans"
    data-redirect-path={redirectPath}
    data-contact-form>
    <input type="hidden" name="_captcha" value="false" />
    <!-- Fallback only: the script rewrites this to "<subject> — <name>" on submit. -->
    <input type="hidden" name="_subject" value={subject} data-subject-line />
    <input type="hidden" name="_template" value="table" />
    <input type="hidden" name="_next" value={fallbackNextUrl} data-next-input />
    <!-- Honeypot: FormSubmit discards any submission where this is filled in. -->
    <input type="text" name="_honey" tabindex="-1" autocomplete="off" style="display:none" />

    <p class="-mb-3 text-sm text-ink-muted">All fields are required.</p>

    <div class="flex flex-col gap-1.5">
        <label for="subject" class={LABEL_CLASS}>Subject</label>
        <div class="group relative">
            <!-- The native popup is placed by the OS and can't be aligned to the field, so the
                 select is kept only as the form value + validity owner and the menu is rebuilt. -->
            <select
                name="subject"
                required
                tabindex="-1"
                aria-hidden="true"
                class="pointer-events-none absolute h-0 w-0 opacity-0"
                data-subject-select>
                <option value="" data-placeholder={BLANK_PLACEHOLDER}></option>
                {
                    INTENTS.map((intent) => (
                        <option
                            value={intent.label}
                            data-placeholder={intent.placeholder}
                            selected={intent.label === defaultSubject}>
                            {intent.label}
                        </option>
                    ))
                }
            </select>
            <button
                type="button"
                id="subject"
                role="combobox"
                aria-controls="subject-listbox"
                aria-expanded="false"
                aria-haspopup="listbox"
                aria-describedby="subject-error"
                class:list={[
                    FIELD_CLASS,
                    "group/trigger flex cursor-pointer items-center justify-between gap-3 text-left aria-expanded:border-ink",
                ]}
                data-subject-trigger>
                <!-- Unselected mirrors the message placeholder (text-base at /70); picking a
                     subject drops back to the field's own text-lg at full ink. -->
                <span
                    data-subject-label
                    class:list={[
                        "truncate",
                        !defaultSubject && "text-base text-ink-muted",
                    ]}>
                    {defaultSubject || "Choose a subject"}
                </span>
                <!-- width/height bound the paint before the stylesheet lands: a viewBox
                     alone gives no intrinsic size, so the chevron resolves to the full
                     container width. The class below wins once CSS applies. -->
                <svg
                    aria-hidden="true"
                    viewBox="0 0 12 8"
                    width="12"
                    height="8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-2 w-3 shrink-0 text-ink-muted group-aria-expanded/trigger:rotate-180">
                    <path d="M1 1.75 6 6.25 11 1.75"></path>
                </svg>
            </button>
            <ul
                id="subject-listbox"
                role="listbox"
                aria-labelledby="subject"
                hidden
                class="absolute top-full right-0 left-0 z-20 mt-1 overflow-hidden rounded-xs border border-ink bg-page py-1"
                data-subject-listbox>
                {
                    INTENTS.map((intent) => (
                        <li
                            role="option"
                            tabindex="-1"
                            data-value={intent.label}
                            aria-selected={intent.label === defaultSubject ? "true" : "false"}
                            class="group/option flex cursor-pointer items-center gap-2.5 px-3 py-2.5 text-lg leading-snug text-ink outline-none hover:bg-tint-strong focus:bg-tint-strong">
                            <svg
                                aria-hidden="true"
                                viewBox="0 0 12 10"
                                width="12"
                                height="10"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.75"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="h-2.5 w-3 shrink-0 invisible group-aria-selected/option:visible">
                                <path d="M1 5.25 4.25 8.5 11 1.5"></path>
                            </svg>
                            {intent.label}
                        </li>
                    ))
                }
            </ul>
        </div>
        <p id="subject-error" class={ERROR_CLASS} data-error-for="subject">
            Please choose what this is about.
        </p>

        <div data-lessons-only hidden={!lessonsDefault} class="pt-2">
            <label
                for="local-to-new-york"
                class="flex cursor-pointer items-start gap-3 text-[15px] leading-normal text-ink-soft">
                <!-- Drawn box instead of the native one, which paints white on the paper.
                     The check mark sits over it as a sibling, since an input can't hold children. -->
                <span class="relative mt-[3px] flex shrink-0">
                    <input
                        type="checkbox"
                        id="local-to-new-york"
                        name="local_to_new_york_city"
                        value="yes"
                        class="peer m-0 h-[18px] w-[18px] cursor-pointer appearance-none rounded-xs border border-field bg-page hover:border-ink checked:border-ink checked:bg-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
                    />
                    <svg
                        aria-hidden="true"
                        viewBox="0 0 12 10"
                        width="12"
                        height="10"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="pointer-events-none invisible absolute inset-0 m-auto h-2.5 w-3 text-page peer-checked:visible">
                        <path d="M1 5.25 4.25 8.5 11 1.5"></path>
                    </svg>
                </span>
                <span>I'm in New York City and open to lessons in person.</span>
            </label>
        </div>
    </div>

    <div class="flex flex-col gap-1.5">
        <label for="name" class={LABEL_CLASS}>Name</label>
        <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            aria-describedby="name-error"
            class={FIELD_CLASS}
        />
        <p id="name-error" class={ERROR_CLASS} data-error-for="name">Please enter your name.</p>
    </div>

    <div class="flex flex-col gap-1.5">
        <label for="email" class={LABEL_CLASS}>Email</label>
        <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            aria-describedby="email-error"
            class={FIELD_CLASS}
        />
        <p id="email-error" class={ERROR_CLASS} data-error-for="email">
            Please enter an email address I can reply to.
        </p>
    </div>

    <div class="flex flex-col gap-1.5">
        <label for="message" class={LABEL_CLASS}>Message</label>
        <textarea
            id="message"
            name="message"
            rows="7"
            required
            aria-describedby="message-error"
            class:list={[FIELD_CLASS, "resize-none leading-relaxed"]}
            placeholder={selectedPlaceholder}></textarea>
        <p id="message-error" class={ERROR_CLASS} data-error-for="message">
            Please add a short message.
        </p>
    </div>

    <button
        type="submit"
        class:list={[
            ACTION_CLASS,
            ACTION_SOLID,
            "cursor-pointer self-start disabled:cursor-default disabled:opacity-60",
        ]}
        data-submit-button>
        {submitLabel}
    </button>
</form>

<script is:inline define:vars={{ LESSONS_SUBJECT: INTENTS[0].label }}>
    document.querySelectorAll("form[data-contact-form]").forEach((form) => {
        const redirectPath = form.getAttribute("data-redirect-path");
        const nextInput = form.querySelector("input[data-next-input]");
        if (redirectPath && nextInput) {
            nextInput.value = new URL(redirectPath, window.location.origin).toString();
        }

        const select = form.querySelector("[data-subject-select]");
        const trigger = form.querySelector("[data-subject-trigger]");
        const listbox = form.querySelector("[data-subject-listbox]");
        const triggerLabel = form.querySelector("[data-subject-label]");
        const message = form.querySelector("#message");
        const lessonsOnly = form.querySelector("[data-lessons-only]");

        const applySubject = () => {
            const option = select.selectedOptions[0];
            if (message) message.placeholder = option.dataset.placeholder;
            if (!lessonsOnly) return;
            const isLessons = option.value === LESSONS_SUBJECT;
            lessonsOnly.hidden = !isLessons;
            // Uncheck when hidden, so a stale answer can't be submitted.
            if (!isLessons) {
                lessonsOnly.querySelectorAll("input[type=checkbox]").forEach((box) => {
                    box.checked = false;
                });
            }
        };

        if (select) {
            select.addEventListener("change", applySubject);
            applySubject();
        }

        if (select && trigger && listbox && triggerLabel) {
            const options = Array.from(listbox.querySelectorAll("[role=option]"));

            const setOpen = (open) => {
                listbox.hidden = !open;
                trigger.setAttribute("aria-expanded", open ? "true" : "false");
                if (open) (options.find((o) => o.ariaSelected === "true") ?? options[0]).focus();
            };

            const choose = (option) => {
                select.value = option.dataset.value;
                select.dispatchEvent(new Event("change", { bubbles: true }));
                triggerLabel.textContent = option.dataset.value;
                triggerLabel.classList.remove("text-base", "text-ink-muted");
                options.forEach((o) => o.setAttribute("aria-selected", String(o === option)));
                setOpen(false);
                trigger.focus();
            };

            trigger.addEventListener("click", () => setOpen(listbox.hidden));
            trigger.addEventListener("keydown", (event) => {
                if (event.key === "ArrowDown" || event.key === "ArrowUp") {
                    event.preventDefault();
                    setOpen(true);
                }
            });

            options.forEach((option, index) => {
                option.addEventListener("click", () => choose(option));
                option.addEventListener("keydown", (event) => {
                    const step = { ArrowDown: 1, ArrowUp: -1 }[event.key];
                    if (step) {
                        event.preventDefault();
                        const next = (index + step + options.length) % options.length;
                        options[next].focus();
                    } else if (event.key === "Enter" || event.key === " ") {
                        event.preventDefault();
                        choose(option);
                    } else if (event.key === "Escape" || event.key === "Tab") {
                        setOpen(false);
                        trigger.focus();
                    }
                });
            });

            document.addEventListener("click", (event) => {
                if (!listbox.hidden && !listbox.parentElement.contains(event.target)) {
                    setOpen(false);
                }
            });
        }

        // The subject select is visually hidden, so its error state and focus ride on the trigger.
        const controlFor = (field) => (field === select && trigger ? trigger : field);

        const showError = (field, show) => {
            const note = form.querySelector(`[data-error-for="${field.name}"]`);
            controlFor(field).setAttribute("aria-invalid", show ? "true" : "false");
            if (note) note.classList.toggle("hidden", !show);
        };

        const submitButton = form.querySelector("[data-submit-button]");
        const submitLabel = submitButton ? submitButton.textContent.trim() : "";

        const fields = Array.from(form.querySelectorAll("[required]"));
        fields.forEach((field) => {
            field.addEventListener("input", () => {
                if (
                    controlFor(field).getAttribute("aria-invalid") === "true" &&
                    field.checkValidity()
                ) {
                    showError(field, false);
                }
            });
            field.addEventListener("change", () => {
                if (
                    controlFor(field).getAttribute("aria-invalid") === "true" &&
                    field.checkValidity()
                ) {
                    showError(field, false);
                }
            });
        });

        form.addEventListener("submit", (event) => {
            const invalid = fields.filter((field) => !field.checkValidity());
            fields.forEach((field) => showError(field, invalid.includes(field)));

            if (invalid.length > 0) {
                event.preventDefault();
                controlFor(invalid[0]).focus();
                return;
            }

            const subjectLine = form.querySelector("[data-subject-line]");
            const name = form.querySelector("#name");
            if (subjectLine && select) {
                subjectLine.value = name && name.value.trim()
                    ? `${select.value} — ${name.value.trim()}`
                    : select.value;
            }

            // The POST is a full navigation, so the pending state holds until it lands.
            if (submitButton) {
                submitButton.disabled = true;
                submitButton.textContent = "Sending…";
            }
        });

        // Coming Back restores this page from the back/forward cache with the pending state
        // frozen in, which would leave the form unsendable.
        window.addEventListener("pageshow", (event) => {
            if (!event.persisted || !submitButton) return;
            submitButton.disabled = false;
            submitButton.textContent = submitLabel;
        });
    });
</script>
