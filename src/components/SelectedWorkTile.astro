---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
    image: ImageMetadata;
    alt: string;
    aspectRatio: number;
    sizes: string;
}

const { image, alt, aspectRatio, sizes } = Astro.props;
---

<div style={`aspect-ratio: ${aspectRatio};`} class="group block transition-[filter] duration-300 dark:brightness-(--thumb-dim) dark:hover:brightness-100">
    <Picture
        src={image}
        alt={alt}
        formats={["avif", "webp"]}
        widths={[320, 480, 640, 768, 960, 1280]}
        sizes={sizes}
        quality={78}
        loading="lazy"
        decoding="async"
        class="block h-full w-full object-contain transition-transform duration-1000 ease-in-out group-hover:scale-[1.01]"
    />
</div>
