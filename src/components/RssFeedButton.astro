---
// Every copy button hands out the combined blog and art feed.
const feedUrl = new URL("/feed/rss.xml", Astro.site).toString();
---

<div class="relative mb-[4px] inline-block" data-rss-copy-root data-feed-url={feedUrl}>
    <button
        type="button"
        data-rss-copy-button
        aria-label="Copy RSS feed URL"
        title="Copy RSS feed URL"
        class="inline-flex items-center gap-1.5 rounded border font-sans border-rule-strong px-2 py-0.5 text-xs leading-none text-ink-muted hover:text-inherit"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="block shrink-0">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
        </svg>
        <span class="block leading-none">RSS</span>
    </button>

    <span
        data-rss-copy-message
        role="status"
        class="pointer-events-none absolute top-full left-0 z-10 mt-2 w-max rounded bg-ink px-2 py-1 text-xs text-page opacity-0 transition-opacity sm:top-1/2 sm:left-full sm:mt-0 sm:ml-2 sm:-translate-y-1/2"
    ></span>
</div>
<script>
    document.querySelectorAll("[data-rss-copy-root]").forEach((root) => {
        if (!(root instanceof HTMLElement) || root.dataset.rssCopyInitialized === "true") {
            return;
        }

        root.dataset.rssCopyInitialized = "true";

        const btn = root.querySelector("[data-rss-copy-button]");
        const msg = root.querySelector("[data-rss-copy-message]");
        const feedUrl = root.dataset.feedUrl;
        let timer: ReturnType<typeof setTimeout> | undefined;

        if (btn instanceof HTMLButtonElement && msg instanceof HTMLElement && feedUrl) {
            const VIEWPORT_MARGIN = 12;
            const MIN_MESSAGE_WIDTH = 80;
            const beside = matchMedia("(width >= 640px)");

            // Keep the message on screen. Under the button it slides left; beside the
            // button it wraps instead, so it never covers the button.
            const positionMessage = () => {
                msg.style.maxWidth = "";
                msg.style.marginLeft = "";

                const rect = msg.getBoundingClientRect();
                const overflow = rect.right - (window.innerWidth - VIEWPORT_MARGIN);
                if (overflow <= 0) return;
                if (beside.matches) {
                    const available = window.innerWidth - VIEWPORT_MARGIN - rect.left;
                    msg.style.maxWidth = `${Math.max(available, MIN_MESSAGE_WIDTH)}px`;
                } else {
                    const shift = Math.min(overflow, rect.left - VIEWPORT_MARGIN);
                    msg.style.marginLeft = `${-shift}px`;
                    msg.style.maxWidth = `${window.innerWidth - 2 * VIEWPORT_MARGIN}px`;
                }
            };

            const show = (text: string) => {
                msg.textContent = text;
                positionMessage();
                msg.style.opacity = "1";
                clearTimeout(timer);
                timer = setTimeout(() => {
                    msg.style.opacity = "0";
                }, 2500);
            };

            btn.addEventListener("click", () => {
                navigator.clipboard.writeText(feedUrl).then(
                    () => show("Copied — paste into your RSS reader"),
                    () => show(`Couldn't copy. The feed is ${feedUrl}`),
                );
            });
        }
    });
</script>
