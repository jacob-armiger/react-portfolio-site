---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Slide {
    src: string | ImageMetadata;
    alt: string;
    caption?: string;
}

interface Props {
    images?: Slide[];
    image?: Slide;
    label?: string;
    className?: string;
    showCaptions?: boolean;
}

const {
    images,
    image,
    label = "Image carousel",
    className = "max-w-5xl",
    showCaptions = false,
} = Astro.props as Props;

const inputImages = [...(image ? [image] : []), ...(Array.isArray(images) ? images : [])];

if (inputImages.length === 0) {
    throw new Error("ImageCarousel requires at least one image.");
}

const isSingleImage = inputImages.length === 1;

const resolvedImages = await Promise.all(
    inputImages.map(async (img) => {
        const source = img.src;

        if (typeof source === "string") {
            return {
                src: source,
                thumbSrc: source,
                thumbWidth: undefined,
                thumbHeight: undefined,
                alt: img.alt,
                caption: img.caption ?? "",
            };
        }

        const targetWidth = isSingleImage ? 1400 : 700;
        const thumbWidth = Math.min(source.width, targetWidth);
        const thumbHeight = Math.round((source.height / source.width) * thumbWidth);
        const optimizedThumb = await getImage({
            src: source,
            width: thumbWidth,
            format: "webp",
            quality: 78,
        });

        return {
            src: source.src,
            thumbSrc: optimizedThumb.src,
            thumbWidth,
            thumbHeight,
            alt: img.alt,
            caption: img.caption ?? "",
        };
    }),
);
---

<section
    class={`not-prose my-8 mx-auto w-full ${className}`}
    aria-label={label}
    data-image-carousel
    data-carousel-single={isSingleImage ? "true" : "false"}>
    <div class="image-carousel-strip">
        {
            resolvedImages.map((image, index) => (
                <figure class="image-carousel-figure">
                    <button
                        type="button"
                        class="image-carousel-thumb"
                        data-carousel-thumb
                        data-carousel-index={index}
                        data-carousel-src={image.src}
                        data-carousel-alt={image.alt}
                        data-carousel-caption-text={image.caption}
                        aria-label={`Open image ${index + 1} in larger view`}>
                        <img
                            src={image.thumbSrc}
                            alt={image.alt}
                            width={image.thumbWidth}
                            height={image.thumbHeight}
                            loading={index === 0 ? "eager" : "lazy"}
                            fetchpriority={index === 0 ? "high" : "auto"}
                            decoding="async"
                            class="image-carousel-thumb-image !m-0 block"
                        />
                    </button>
                    {showCaptions && image.caption ? (
                        <figcaption class="image-carousel-caption font-sans">
                            {image.caption}
                        </figcaption>
                    ) : null}
                </figure>
            ))
        }
    </div>

</section>

<script is:inline>
    (() => {
        const init = () => {
            const roots = Array.from(document.querySelectorAll("[data-image-carousel]"));
            if (roots.length === 0) return;

            roots.forEach((root) => {
                if (!(root instanceof HTMLElement)) return;
                if (root.dataset.carouselInitialized === "true") return;
                root.dataset.carouselInitialized = "true";

                const thumbs = Array.from(root.querySelectorAll("[data-carousel-thumb]"));
                if (thumbs.length === 0) return;

                const srcs = thumbs.map((t) => t.getAttribute("data-carousel-src") || "");
                const previewSrcs = thumbs.map((t) => {
                    const previewImg = t.querySelector("img");
                    return previewImg?.currentSrc || previewImg?.src || "";
                });

                const prewarm = (index) => {
                    const src = srcs[index];
                    if (!src) return;
                    if (typeof window.preloadImageZoomSrc === "function") {
                        window.preloadImageZoomSrc(src);
                        return;
                    }
                    const prefetchImg = new Image();
                    prefetchImg.decoding = "async";
                    prefetchImg.src = src;
                };

                thumbs.forEach((thumb, i) => {
                    thumb.addEventListener("mouseenter", () => prewarm(i));
                    thumb.addEventListener("touchstart", () => prewarm(i), { passive: true });

                    thumb.addEventListener("click", () => {
                        if (typeof window.openImageZoom === "function") {
                            window.openImageZoom(srcs[i], {
                                srcs,
                                startIndex: i,
                                previewSrc: previewSrcs[i],
                                previewSrcs,
                            });
                        }
                    });
                });
            });
        };

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", init);
        } else {
            init();
        }
    })();
</script>

<style is:inline>
    .image-carousel-strip {
        display: flex;
        flex-wrap: nowrap;
        /* Shared top line, like the home and art galleries. Centring left uneven
           heights hanging at different offsets down the strip. */
        align-items: flex-start;
        gap: 1rem;
        overflow-x: auto;
        overflow-y: hidden;
        padding-bottom: 0.25rem;
        -webkit-overflow-scrolling: touch;
    }

    .image-carousel-figure {
        flex: 0 0 auto;
        width: fit-content;
        max-width: 16.5rem;
        margin: 0;
    }

    /*
     * The site's plate: a hairline directly on the image, no mat, no fill, square
     * corners, so the page texture stays continuous and the edge is one pixel at any
     * zoom. Matches the article cover and the blog card thumbnails.
     */
    .image-carousel-thumb {
        display: block;
        padding: 0;
        border: 1px solid var(--plate-rule);
        background: none;
        line-height: 0;
        /* Same affordance the art grid uses for this exact modal. A drop shadow here
           read as decoration while the card's hard offset meant "clickable". */
        cursor: zoom-in;
        transition: border-color 150ms ease;
    }

    .image-carousel-thumb:hover,
    .image-carousel-thumb:focus-visible {
        border-color: var(--plate-accent);
    }

    .image-carousel-thumb:focus-visible {
        outline: 2px solid var(--plate-accent);
        outline-offset: 2px;
    }

    .image-carousel-thumb-image {
        /* Beats Prose's `[&_img]:w-full`, which `not-prose` does not cancel -- that
           variant compiles without Typography's not-prose exclusion. */
        width: auto !important;
        max-width: 100%;
        max-height: 30rem;
        height: auto;
    }

    /* Sans, like the dateline and the cover caption. Sentence case rather than their
       small caps: those are credit lines, this carries a sentence. */
    .image-carousel-caption {
        margin-top: 0.75rem;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.06em;
        line-height: 1.5;
        opacity: 0.65;
    }

    /* Left-aligned, not centred: a lone figure otherwise sat on its own left edge,
       drifting off the one the cover, title and prose all share. */
    [data-carousel-single="true"] .image-carousel-strip {
        display: block;
        overflow-x: visible;
    }

    [data-carousel-single="true"] .image-carousel-figure {
        width: fit-content;
        max-width: 100%;
    }

    [data-carousel-single="true"] .image-carousel-thumb-image {
        max-width: min(34rem, 100%);
        max-height: 66vh;
    }

    .image-carousel-strip::-webkit-scrollbar {
        height: 10px;
    }

    .image-carousel-strip::-webkit-scrollbar-thumb {
        border-radius: 9999px;
        background: rgb(120 113 108 / 0.4);
    }

    /* No dark override needed: --plate-rule and --plate-accent flip in the layout, so
       both themes come from the same place as the cover and the cards. */
</style>
