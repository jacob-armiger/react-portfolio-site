---
interface Props {
    date: Date;
    minutes: number;
    class?: string;
}

const { date, minutes, class: className } = Astro.props;

// "JUNE 2, 2026". Fixed to UTC so the frontmatter date is the one that prints,
// whatever the reader's timezone.
const dateLabel = date
    .toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "UTC",
    })
    .toUpperCase();
---

<p class:list={["dateline font-sans", className]}>
    <span>{dateLabel}</span>
    <span aria-hidden="true" class="dateline__bullet">&bull;</span>
    <span>{minutes} min read</span>
</p>

<style>
    /* The one piece of sans in the article furniture, tracked like a newspaper kicker
       so it sits under the headline without competing. */
    .dateline {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.16em;
        opacity: 0.65;
        text-transform: uppercase;
    }

    .dateline__bullet {
        color: var(--plate-accent);
        font-size: 9px;
        /* Full strength against the dateline's 0.65, so it reads as a deliberate
           mark rather than a stray dot. */
        opacity: 1;
    }
</style>
