---
interface Props {
    date: Date;
    minutes: number;
    class?: string;
}

const { date, minutes, class: className } = Astro.props;

// e.g. "JUNE 2, 2026". UTC so the frontmatter date prints regardless of timezone.
const dateLabel = date
    .toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "UTC",
    })
    .toUpperCase();
---

<p class:list={["dateline font-sans", className]}>
    <span>{dateLabel}</span>
    <span aria-hidden="true" class="dateline__bullet">&bull;</span>
    <span>{minutes} min read</span>
</p>

<style>
    .dateline {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.16em;
        opacity: 0.65;
        text-transform: uppercase;
    }

    .dateline__bullet {
        color: var(--plate-accent);
        font-size: 9px;
        /* Full opacity against the dateline's 0.65 so the accent color shows. */
        opacity: 1;
    }
</style>
